{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_sha256", "image", "network", "controls", "raw_sha256"],
  "properties": {
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {"type": "object", "required": ["reference", "digest"], "properties": {
      "reference": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }},
    "network": {"const": "none"},
    "controls": {"type": "array", "items": {"enum": ["stale_xid", "old_process", "positive_p2_effect"]}},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
