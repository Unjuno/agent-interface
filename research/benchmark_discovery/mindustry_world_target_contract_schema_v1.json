{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "receipt_index", "point_space", "point", "motion_model", "evidence_kind", "relation"],
      "properties": {
        "op": {"const": "target_reference"},
        "receipt_index": {"type": "integer", "const": 1},
        "point_space": {"const": "source_observation_pixels"},
        "point": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
        },
        "motion_model": {"const": "surface_origin_translation"},
        "evidence_kind": {"const": "animated_placement_preview_context"},
        "relation": {"const": "directly_above_copper_source"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "receipt_index", "evidence_kind", "reason"],
      "properties": {
        "op": {"const": "needs_decision"},
        "receipt_index": {"type": "integer", "const": 1},
        "evidence_kind": {"const": "animated_placement_preview_context"},
        "reason": {"type": "string", "enum": ["no_match", "ambiguous_relation", "unreadable_evidence"]}
      }
    }
  ]
}
