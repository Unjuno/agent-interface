{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "receipt_index", "point_space", "points", "motion_model", "evidence_kind", "relation", "reason"],
  "properties": {
    "op": {"type": "string", "enum": ["target_reference", "needs_decision"]},
    "receipt_index": {"type": "integer", "const": 1},
    "point_space": {"type": "string", "enum": ["source_observation_pixels", "not_applicable"]},
    "points": {
      "type": "array", "minItems": 0, "maxItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["x", "y"],
        "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}}
    },
    "motion_model": {"type": "string", "enum": ["surface_origin_translation", "not_applicable"]},
    "evidence_kind": {"type": "string", "enum": ["animated_placement_preview_context"]},
    "relation": {"type": "string", "enum": ["directly_above_copper_source", "not_applicable"]},
    "reason": {"type": "string", "enum": ["matched", "no_match", "ambiguous_relation", "unreadable_evidence"]}
  }
}
