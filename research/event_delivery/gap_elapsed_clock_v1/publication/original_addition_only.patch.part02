+{"role":"producer","scheduled_ms":null,"request_line":"{\"op\":\"stop\",\"request_id\":\"local-gap-clock-20260922-01-r2-tail40-slow-OBS_COUNT_3:9\"}\n","response_line":"{\"status\":\"STOPPED\",\"request_id\":\"local-gap-clock-20260922-01-r2-tail40-slow-OBS_COUNT_3:9\",\"pid\":2068,\"begin_ns\":934992672211,\"end_ns\":934992679301}\n","sent_ns":934992553772,"received_ns":934993247467,"before":{"consumer":[[3,"E3","43bb00d0ce7790a53b91256b370c887b24791a5539a6fbfb70c5870e8c91ae5d"]],"pending":[[5,5,"E5","536c351ae15e5f5e3dc37bcc5dea8ab641e70fc0431a088a1d684aef2ebf3e5b"],[6,6,"E6","7d087a2e212c110e851c7b6fdc2853a41e7db1690beef7a9c11b3a26ee77e853"]],"ack":[[2,"d80a79bc51654024d9b4eebe7077308236771c1e42aaa961e2b8bf460c333be4"]]},"after":{"consumer":[[3,"E3","43bb00d0ce7790a53b91256b370c887b24791a5539a6fbfb70c5870e8c91ae5d"]],"pending":[[5,5,"E5","536c351ae15e5f5e3dc37bcc5dea8ab641e70fc0431a088a1d684aef2ebf3e5b"],[6,6,"E6","7d087a2e212c110e851c7b6fdc2853a41e7db1690beef7a9c11b3a26ee77e853"]],"ack":[[2,"d80a79bc51654024d9b4eebe7077308236771c1e42aaa961e2b8bf460c333be4"]]}}
+{"role":"consumer","scheduled_ms":null,"request_line":"{\"op\":\"stop\",\"request_id\":\"local-gap-clock-20260922-01-r2-tail40-slow-OBS_COUNT_3:10\"}\n","response_line":"{\"status\":\"STOPPED\",\"request_id\":\"local-gap-clock-20260922-01-r2-tail40-slow-OBS_COUNT_3:10\",\"pid\":2078,\"begin_ns\":934993751098,\"end_ns\":934993754937}\n","sent_ns":934993691648,"received_ns":934996043738,"before":{"consumer":[[3,"E3","43bb00d0ce7790a53b91256b370c887b24791a5539a6fbfb70c5870e8c91ae5d"]],"pending":[[5,5,"E5","536c351ae15e5f5e3dc37bcc5dea8ab641e70fc0431a088a1d684aef2ebf3e5b"],[6,6,"E6","7d087a2e212c110e851c7b6fdc2853a41e7db1690beef7a9c11b3a26ee77e853"]],"ack":[[2,"d80a79bc51654024d9b4eebe7077308236771c1e42aaa961e2b8bf460c333be4"]]},"after":{"consumer":[[3,"E3","43bb00d0ce7790a53b91256b370c887b24791a5539a6fbfb70c5870e8c91ae5d"]],"pending":[[5,5,"E5","536c351ae15e5f5e3dc37bcc5dea8ab641e70fc0431a088a1d684aef2ebf3e5b"],[6,6,"E6","7d087a2e212c110e851c7b6fdc2853a41e7db1690beef7a9c11b3a26ee77e853"]],"ack":[[2,"d80a79bc51654024d9b4eebe7077308236771c1e42aaa961e2b8bf460c333be4"]]}}
