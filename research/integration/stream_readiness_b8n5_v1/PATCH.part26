index 0000000..8a887f6
--- /dev/null
+++ b/research/integration/stream_readiness_b8n5_v1/verify_readonly.py
@@ -0,0 +1,75 @@
+"""Verify retained bytes, frozen source, and saved-data audits only.
+
+Does not run actor.py, run_batch.py or execute.py. Destination must be new and
+outside the evidence tree. Trusted local filesystem; not an adversarial sandbox.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT=Path(__file__).resolve().parent
+
+def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def verify():
+    manifest=json.loads((ROOT/'SHA256SUMS.json').read_text())
+    found={str(p.relative_to(ROOT)) for p in ROOT.rglob('*') if p.is_file() and p.name!='SHA256SUMS.json'}
+    if found!=set(manifest['files']):raise ValueError('inventory')
+    for name,spec in manifest['files'].items():
+        p=ROOT/name
+        if p.is_symlink() or p.stat().st_size!=spec['bytes'] or digest(p)!=spec['sha256']:
+            raise ValueError('member:'+name)
+    freeze=json.loads((ROOT/'FREEZE.json').read_text())
+    for name,expected in freeze['sha256'].items():
+        if digest(ROOT/name)!=expected:raise ValueError('source:'+name)
+    for batch in range(3):
+        if (ROOT/f'pilot_receipts/batch-{batch}.exit').read_bytes()!=b'0\n':raise ValueError('outer_shell_exit')
+        if (ROOT/f'pilot_receipts/batch-{batch}.stderr').read_bytes()!=b'':raise ValueError('outer_shell_stderr')
+        batchdir=ROOT/f'pilot/batch-{batch}'
+        for name in json.loads((batchdir/'END.json').read_text())['cases']:
+            record=json.loads((batchdir/name/'EXECUTION.json').read_text())
+            for role in ('writer','reader'):
+                argv=record['actors'][role]['argv']
+                if len(argv)!=8 or argv[1:3]!=['-S','-B'] or Path(argv[3]).name!='actor.py' or argv[4]!=role:
+                    raise ValueError('actor_argv')
+                if Path(argv[6]).name!='CONFIG.json' or Path(argv[7]).name!=role+'.json':
+                    raise ValueError('actor_file_argv')
+    receipts=[]
+    with tempfile.TemporaryDirectory(prefix='b8n5-readonly-') as tmp:
+        work=Path(tmp)
+        commands=[('pilot_audit','audit.py','pilot','0,1,2','AUDIT.json'),
+                  ('pilot_controls','controls.py','pilot','0,1,2','CONTROLS.json'),
+                  ('development_audit','audit.py','development','0','DEVELOPMENT_AUDIT_WITH_FREEZE.json')]
+        for label,script,stage,batches,reference in commands:
+            output=work/(label+'.json')
+            argv=[sys.executable,'-S','-B',str(ROOT/'source'/script),str(ROOT),stage,batches,str(output)]
+            start=time.monotonic_ns();p=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+            out,err=p.communicate(timeout=20)
+            if p.returncode or err:raise RuntimeError(label+':'+err.decode(errors='replace'))
+            if output.read_bytes()!=(ROOT/reference).read_bytes():raise ValueError('audit_output:'+label)
+            receipts.append({'label':label,'pid':p.pid,'returncode':p.returncode,'start_ns':start,
+                             'end_ns':time.monotonic_ns(),'byte_identical_to':reference,
+                             'sha256':digest(output)})
+        argv=[sys.executable,'-S','-B','-m','unittest','discover','-s',str(ROOT/'source'),'-p','test_policy.py','-v']
+        p=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE);out,err=p.communicate(timeout=10)
+        if p.returncode or b'Ran 12 tests' not in err:raise ValueError('unit_result')
+        receipts.append({'label':'units','pid':p.pid,'returncode':p.returncode,'methods':12})
+    for name,spec in manifest['files'].items():
+        if digest(ROOT/name)!=spec['sha256']:raise ValueError('verification_mutated:'+name)
