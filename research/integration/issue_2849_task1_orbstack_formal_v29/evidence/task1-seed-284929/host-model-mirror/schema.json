{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "field", "submit"],
  "properties": {
    "format": {"type": "string", "const": "plain-form-points-v1"},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_space", "point"],
      "properties": {
        "point_space": {"type": "string", "const": "source_observation_pixels"},
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
        }
      }
    },
    "submit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_space", "point"],
      "properties": {
        "point_space": {"type": "string", "const": "source_observation_pixels"},
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
        }
      }
    }
  }
}
