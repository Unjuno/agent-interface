{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-interface/golden-v3-result-v1",
  "type": "object",
  "required": ["schema","program_completed","task_success","authority_granted","status","partial_effects","cleanup_error","lifecycle","usage"],
  "properties": {
    "schema": {"const": "golden-v3-result-v1"},
    "program_completed": {"type": "boolean"},
    "task_success": {"type": "boolean"},
    "authority_granted": {"const": false},
    "status": {"enum": ["success","partial","refused","stale_invalidated","cleanup_failed"]},
    "partial_effects": {"type": "array"},
    "cleanup_error": {"type": ["string","null"]},
    "lifecycle": {"type": "array", "items": {"enum": ["doctor","model_attempt","observation","dispatch","refusal","effect","repair","release","cleanup"]}},
    "usage": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "success"}}}, "then": {"properties": {"program_completed": {"const": true}, "task_success": {"const": true}, "cleanup_error": {"const": null}}}},
    {"if": {"properties": {"cleanup_error": {"type": "string"}}}, "then": {"properties": {"status": {"const": "cleanup_failed"}, "task_success": {"const": false}}}}
  ]
}
