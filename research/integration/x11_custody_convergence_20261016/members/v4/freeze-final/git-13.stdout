+        execution=self.execute_changed(X.MappingKeyboard,[{'op':'key_state','key':'w','down':True},{'op':'wait_update','timeout_ms':1},{'op':'key_state','key':'w','down':False},{'op':'text','text':'_'},{'op':'release_all'}],
