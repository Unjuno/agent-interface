+      "<Shift-MouseWheel>": "\n\tif {%D >= 0} {\n\t    %W xview scroll [expr {-%D/3}] pixels\n\t} else {\n\t    %W xview scroll [expr {(2-%D)/3}] pixels\n\t}\n    ",
+      "<Triple-Button-1>": "\n    set tk::Priv(selectMode) line\n    tk::TextSelectTo %W %x %y\n    catch {%W mark set insert sel.first}\n",
+      "<Triple-Shift-Button-1>": "\n    set tk::Priv(selectMode) line\n    tk::TextSelectTo %W %x %y\n"
