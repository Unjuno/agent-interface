diff --git a/research/integration/undo_compare_commit_v1/audit.py b/research/integration/undo_compare_commit_v1/audit.py
new file mode 100644
index 0000000..8df13a6
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/audit.py
@@ -0,0 +1,205 @@
+"""Raw-only audit: no candidate/runner/Tk/Xlib import and no GUI invocation."""
+from __future__ import annotations
+import argparse,hashlib,json
+from pathlib import Path
+
+ROUTES=('SPLIT_KEY','INLINE_NO_YIELD','INLINE_YIELD','INLINE_RECHECK')
+SCENARIOS=('QUIET','EARLY_EDIT','AFTER_CHECK_INSERT','AFTER_CHECK_ABA','AFTER_COMMIT_INSERT')
+TABLE={
+ 'QUIET':('base:p',)*4,
+ 'EARLY_EDIT':('base:pxy',)*4,
+ 'AFTER_CHECK_INSERT':('base:px','base:py','base:px','base:pxy'),
+ 'AFTER_CHECK_ABA':('base:pxy','base:p','base:pxy','base:px'),
+ 'AFTER_COMMIT_INSERT':('base:py',)*4,
+}
+class Invalid(Exception):pass
+
+def need(v,message):
+    if not v:raise Invalid(message)
+def integer(v):return type(v) is int
+
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+def load(p):return json.loads(p.read_text())
+def receipt(r,owner):
+    need(type(r) is dict,'receipt type')
+    need(r.get('kind')=='APP_HISTORY_SNAPSHOT','receipt kind')
+    for k in ('pid','widget_xid','revision'):
+        need(integer(r.get(k)) and r[k]>=0,'receipt integer '+k)
+    need(type(r.get('text')) is str,'receipt text type')
+    need(r['sha256']==hashlib.sha256(r['text'].encode()).hexdigest(),'receipt text hash')
+    need(r['pid']==owner['pid'] and r['widget_xid']==owner['widget_xid'] and r['session']==owner['session'],'receipt identity')
+    need(r['focus']==owner['widget_path'],'receipt focus')
+def eligible(ref,cur,owner):
+    receipt(ref,owner);receipt(cur,owner)
+    return ref['text']=='base:px' and ref['separators']==2 and cur['text']==ref['text'] and cur['revision']==ref['revision']
+def neutral(s):
+    need(type(s['keys']) is list and len(s['keys'])==32,'keymap shape')
+    need(all(integer(x) and x==0 for x in s['keys']),'keymap nonneutral/type')
+    need(integer(s['buttons']) and s['buttons']==0,'buttons nonneutral/type')
+def taps(names):return [(k,b) for k in names for b in (True,False)]
+
+def inspect_case(d,row):
+    route=row['route'];scenario=row['schedule'];owner=row['ready']
+    need(not row['errors'] and integer(row['app_returncode']) and row['app_returncode']==0,'app errors/exit')
+    need(not (d/'app.stderr').read_bytes(),'app stderr')
+    need(integer(owner['pid']) and owner['session']==row['case_id'],'owner identity')
+    need(owner['tk_patchlevel']=='8.6.16','Tk version')
+    for k in ('initial_server','final_server','cleanup_server'):neutral(row[k])
+    for k in ('initial','protected','start_group','task','reference','client_check','terminal'):
+        receipt(row[k],owner)
+    need(row['initial']['text']=='base:' and row['protected']['text']=='base:p' and row['task']['text']=='base:px','initial actual effects')
+    need(row['reference']['revision']==4 and row['reference']['text']=='base:px','reference baseline history')
+    decision=eligible(row['reference'],row['client_check'],owner)
+    need(type(row['client_decision']['admit']) is bool and row['client_decision']['admit']==decision,'client decision')
+    expected_undo=scenario!='EARLY_EDIT' and not(route=='INLINE_RECHECK' and scenario.startswith('AFTER_CHECK'))
+    need(type(row['undo_invoked']) is bool and row['undo_invoked']==expected_undo,'undo decision gate')
+    expected=TABLE[scenario][ROUTES.index(route)]
+    need(row['terminal']['text']==expected,'scientific final gate')
+    need((d/'final.txt').read_bytes()==expected.encode(),'final file bytes')
+    # Exact retained message bytes and application/source identity.
+    sent=[];received=[];last_id=-1
+    for e in row['ipc']:
+        need(e['raw'].endswith('\n') and integer(e['mono_ns']),'IPC framing/time')
+        x=json.loads(e['raw'])
+        if e['direction']=='send':
+            need(integer(x['id']) and x['id']==last_id+1,'IPC send sequence');last_id=x['id'];sent.append(x)
+        else:
+            need(x['pid']==owner['pid'] and integer(x['pid']) and x['session']==owner['session'],'IPC receive identity')
+            received.append(x)
+    need(received[0]==owner,'ready raw binding')
+    for req in sent:
+        rr=[r for r in received[1:] if r.get('request_id')==req['id']]
+        if req['op']=='conditional_undo':
+            need(set(req)=={'id','op','mode','reference'},'application received hidden fields')
+            need(req['reference']==row['reference'] and req['mode']==route,'inline request binding')
+            need(rr[-1]==row['operation_result'] and len(rr) in (1,2),'inline result raw binding')
+        else:need(len(rr)==1,'request response cardinality')
+    snapshots={r['request_id']:r for r in received if r.get('event')=='snapshot'}
+    for r in row.values():
+        if type(r) is dict and r.get('event')=='snapshot':need(snapshots.get(r['request_id'])==r,'snapshot raw binding')
+    need(received[-1]==row['closing'] and received[-1]['text']==expected,'closing raw binding')
+    # Native emitters are independent processes; sent keys exactly match receiver.
+    primary=taps(['p','F12','x','F12'])
+    if route=='SPLIT_KEY' and expected_undo:primary += [('Control_L',True),('z',True),('z',False),('Control_L',False)]
+    need([(r['keysym'],r['down']) for r in row['input']]==primary,'primary input schedule')
+    allinput=list(row['input']);competitor_pid=None
+    expected_competitor=[] if scenario=='QUIET' else (['y','F12','BackSpace','F12'] if scenario=='AFTER_CHECK_ABA' else ['y','F12'])
+    need(len(row['competitors'])==bool(expected_competitor),'competitor cardinality')
+    for c in row['competitors']:
+        need(integer(c['returncode']) and c['returncode']==0 and not c['stderr'],'competitor exit')
+        x=json.loads(c['stdout']);competitor_pid=x['pid']
+        need(integer(competitor_pid) and competitor_pid!=owner['pid'],'separate native sender')
+        need([(r['keysym'],r['down']) for r in x['events']]==taps(expected_competitor),'competitor keys')
+        need(not any(x['before']['keys']) and not any(x['after']['keys']),'sender neutral')
+        need(c['before_ns']<x['events'][0]['before_ns']<=x['events'][-1]['after_ns']<c['after_ns'],'sender timing envelope')
+        allinput+=x['events']
+    for x in allinput:
+        need(integer(x['keycode']) and type(x['down']) is bool and integer(x['before_ns']) and integer(x['after_ns']) and x['before_ns']<=x['after_ns'],'native field types/timing')
+    allinput.sort(key=lambda x:x['before_ns'])
+    app=[json.loads(l) for l in (d/'app.jsonl').read_text().splitlines()]
+    need([r['seq'] for r in app]==list(range(1,len(app)+1)),'journal sequence')
+    rev=0;contents='base:';previous_time=-1
+    undo_records=[];y_records=[];key_records=[]
+    def offset(token,text):
+        if token=='insert':return len(text)
+        if token=='insert-1c':return len(text)-1
+        need(token.startswith('1.') and token[2:].isdigit(),'unsupported raw index')
+        return int(token[2:])
+    for e in app:
+        need(integer(e['seq']) and integer(e['revision']) and integer(e['mono_ns']),'journal strict integer')
+        need(e['pid']==owner['pid'] and integer(e['pid']) and e['session']==owner['session'],'journal identity')
+        need(e['mono_ns']>=previous_time,'journal clock order');previous_time=e['mono_ns']
+        kind=e['event'];need(kind not in ('callback_error','command_error'),'application callback/command error')
+        if kind=='history_command':
+            rev+=1;p=e['parts']
+            if p[0] in ('insert','delete'):
+                need(e['before']==contents,'primitive before state')
+                idx=offset(p[1],contents);need(0<=idx<=len(contents),'primitive index range')
+                if p[0]=='insert':
+                    contents=contents[:idx]+p[2]+contents[idx:]
+                    if p[1]=='insert' and p[2]=='y':y_records.append(e)
+                else:
+                    end=offset(p[2],contents) if len(p)>2 else idx+1
+                    need(idx<=end<=len(contents),'delete range')
+                    contents=contents[:idx]+contents[end:]
+            else:
+                need(p[0]=='edit' and p[1] in ('undo','separator'),'unexpected mutation command')
+                if p[1]=='undo':undo_records.append(e)
+                else:need(e['before']==contents,'separator state')
+        need(e['revision']==rev and e['text']==contents,'journal revision/content replay')
+        if kind=='key':key_records.append(e)
+        if kind=='snapshot':
+            sr=snapshots[e['request_id']]
+            need(sr['journal_seq']==e['seq'] and sr['text']==contents and sr['revision']==rev,'snapshot journal join')
+    need(contents==expected and app[-1]['event']=='closing','terminal history')
+    need(len(undo_records)==int(expected_undo),'native Tk undo count')
+    need(len(y_records)==int(bool(expected_competitor)),'native competing insert count')
+    observed=[(e['keysym'],e['direction']=='down',e['keycode']) for e in key_records]
+    emitted=[(e['keysym'],e['down'],e['keycode']) for e in allinput]
+    need(observed==emitted,'native/application key cardinality/order')
+    # Validate the concurrency discriminator, not just final strings.
+    events={name:[e for e in app if e['event']==name] for name in ('compare','permit_received','yield_begin','yield_end','recheck','undo_begin','undo_end')}
+    if route!='SPLIT_KEY':
+        need(len(events['compare'])==1,'inline compare count')
+        first=events['compare'][0];receipt(first['receipt'],owner)
+        need(first['decision']['admit']==eligible(row['reference'],first['receipt'],owner),'inline initial gate')
+        res=row['operation_result']
+        need(res['undo_invoked']==expected_undo and res['status']==('APPLIED' if expected_undo else 'REFUSED'),'inline terminal disposition')
+        if scenario!='EARLY_EDIT':
+            need(len(events['permit_received'])==1 and row['checked']['event']=='checked','permit handshake')
+            need(events['permit_received'][0]['mono_ns']>=row['permit_ns'],'permit causal order')
+            if scenario.startswith('AFTER_CHECK'):
+                c=row['competitors'][0]
+                need(first['mono_ns']<c['before_ns']<c['after_ns']<row['permit_ns'],'competing input between check and permit')
+            if route=='INLINE_NO_YIELD':need(not events['yield_begin'] and not events['yield_end'],'no-yield really no event pump')
+            else:
+                need(len(events['yield_begin'])==len(events['yield_end'])==1,'yield brackets')
+                if scenario.startswith('AFTER_CHECK'):
+                    need(events['yield_begin'][0]['seq']<y_records[0]['seq']<events['yield_end'][0]['seq'],'reentrant native edit bracket')
+            if route=='INLINE_RECHECK':
+                need(len(events['recheck'])==1,'recheck count')
+                e=events['recheck'][0];receipt(e['receipt'],owner)
+                need(e['decision']['admit']==eligible(row['reference'],e['receipt'],owner)==expected_undo,'recheck exact gate')
+            if expected_undo:
+                need(len(events['undo_begin'])==len(events['undo_end'])==1,'inline undo brackets')
+                need(events['undo_begin'][0]['seq']<undo_records[0]['seq']<events['undo_end'][0]['seq'],'inline native undo enclosed')
+                if scenario.startswith('AFTER_CHECK') and route=='INLINE_NO_YIELD':
+                    need(undo_records[0]['seq']<y_records[0]['seq'],'pending input preserved AFTER undo')
+                if scenario=='AFTER_CHECK_ABA' and route=='INLINE_YIELD':
+                    need(res['preundo']['text']==row['reference']['text'] and res['preundo']['revision']>row['reference']['revision'],'ABA same content distinct history')
+    elif scenario.startswith('AFTER_CHECK'):
+        need(row['client_check']['mono_ns']<row['competitors'][0]['before_ns']<row['undo_start_ns'],'split causal gap')
+        need(y_records[0]['seq']<undo_records[0]['seq'],'split edit before undo')
+    if scenario=='AFTER_COMMIT_INSERT':need(undo_records[0]['seq']<y_records[0]['seq'],'postcommit ordering')
+    outcome='UNRESOLVED' if not expected_undo else ('WRONG_UNDO' if scenario.startswith('AFTER_CHECK') and route in ('SPLIT_KEY','INLINE_YIELD') else 'CORRECT_UNDO')
+    return dict(case_id=row['case_id'],route=route,scenario=scenario,final_text=expected,outcome=outcome,app_pid=owner['pid'],competitor_pid=competitor_pid,journal_rows=len(app))
+
+def audit_batch(root:Path,batch:Path,check_sources=True):
+    errors=[];rows=[]
+    try:
+        if check_sources and (root/'FREEZE.json').exists():
+            for n,h in load(root/'FREEZE.json')['sources'].items():need(sha(root/n)==h,'frozen source '+n)
+        manifest=load(batch/'MANIFEST.json')
+        files={str(p.relative_to(batch)) for p in batch.rglob('*') if p.is_file() and p.name!='MANIFEST.json'}
+        need(files==set(manifest),'raw manifest inventory')
+        for n,h in manifest.items():need(sha(batch/n)==h,'raw file hash '+n)
+        end=load(batch/'END.json');need(not end['errors'],'orchestrator errors')
+        need(len(end['rows'])==20 and len(set(end['rows']))==20,'case denominator/uniqueness')
+        need(integer(end['batch']),'batch strict type')
+        exit=load(root/(batch.name+'.exit.json'));need(integer(exit['returncode']) and exit['returncode']==0 and exit['timed_out'] is False,'actual supervisor exit')
+        need(load(batch/'server_exit.json')['returncode']==0,'server exit')
+        expected=[(s,r) for s in SCENARIOS for r in (reversed(ROUTES) if end['batch']==1 else ROUTES)]
+        for i,(s,r) in enumerate(expected):
+            d=batch/f'case-{i:02d}';row=load(d/'row.json')
+            need(row['case_id']==end['rows'][i] and row['route']==r and row['schedule']==s,'schedule identity')
+            rows.append(inspect_case(d,row))
+        need(len({r['app_pid'] for r in rows})==20,'fresh app PIDs')
+    except Exception as e:errors.append(type(e).__name__+': '+str(e))
+    return dict(status='PASS_RAW_AUDIT' if not errors else 'FAIL_RAW_AUDIT',cases=len(rows),rows=rows,errors=errors)
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--root',type=Path,default=Path(__file__).resolve().parent);p.add_argument('--batch',required=True);p.add_argument('--out',type=Path,required=True)
+    a=p.parse_args();result=audit_batch(a.root,a.root/a.batch)
+    with a.out.open('x') as f:json.dump(result,f,indent=2,sort_keys=True);f.write('\n')
+    print(json.dumps({'status':result['status'],'cases':result['cases'],'errors':result['errors']}));return bool(result['errors'])
+if __name__=='__main__':raise SystemExit(main())
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/PLAN.md b/research/integration/undo_compare_commit_v1/construction-01-source/PLAN.md
new file mode 100644
index 0000000..06d4fc8
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/PLAN.md
@@ -0,0 +1,113 @@
+# Same-callback compare/Undo and event-loop reentrancy
+
+## Origin and current roadmap
+This is a new check-to-effect application-contract study after closed #4043,
+and the preserved conversation-local45-case history study. No predecessor GUI
+allocation is repeated. #431/#438 already show that an application-side call
+is not a general atomicity certificate in LibreOffice; no novelty claim is made.
+Current PR4054 (old24 + separate12) is merged; the local45 is a distinct archive.
+This experiment addresses #2789 result/recovery semantics, not a runtime rewrite.
+
+Roadmap: live read/intake and duplicate check -> old raw-only audit -> excluded
+construction -> local source/environment/decision freeze -> two immutable
+20-case formal batches -> raw-only audit and corruption controls -> additive
+source/raw/report delivery -> GitHub PR/main only when a supported write route
+is available. Publication incidents stay here, not wrapper-only successor Issues.
+The experiment and the global roadmap are not the same deliverable.
+
+## H
+H1. A history-checked client can still Undo the wrong edit if a competing edit
+is processed after that check but before an ordinary native Undo chord.
+H2. One app-side callback that validates a matching history and invokes native
+Tk edit undo without servicing events can serialize that finite operation before
+pending native-key edits. Those edits must survive and be processed afterward.
+H3. A nominally single callback that calls update between check and Undo can
+process those edits and undo the wrong group. Rechecking after update should
+refuse changed history instead. Refusal is unresolved, not successful Undo.
+
+## T
+Provided Linux x86_64 execution container, actual CPython/Tk/Xlib/Xvfb versions
+and hashes collected before freeze. No Docker/OrbStack image-attestation claim.
+New private authenticated Xvfb, TCP disabled. No host DISPLAY, model/provider,
+network experiment, user files, installation or production runtime. Four routes:
+SPLIT_KEY, INLINE_NO_YIELD, INLINE_YIELD, INLINE_RECHECK.
+Five schedules: QUIET, EARLY_EDIT, AFTER_CHECK_INSERT, AFTER_CHECK_ABA,
+AFTER_COMMIT_INSERT. Two repetitions per cell =40 fresh app processes, two
+prospectively fixed20-case batches, one invocation each, no retry/tuning/pooling.
+Construction uses rep-1, disjoint output, at most three logged engineering edits.
+Each response <=3s, child startup<=8s, whole batch<=35s under45s outer tool call.
+Missing/failed/source-changed batch is terminal; no next batch without exit0.
+
+All cases initialize Text base: then native p, app-owned F12 separator, native x,
+F12 separator. Reference receipt binds session/PID/widget/history revision/text.
+The app has no scenario label. Task edits and competitor edits use native XTEST
+from different sender processes/connections. F12 is an explicit app separator,
+not a generic key. Candidate compare/Undo is an explicit cooperative application
+API, not universal GUI control. No hidden direct text setter for task edits.
+SPLIT_KEY checks the reference then sends native Ctrl+z after the competing
+stream is app-fenced. Inline routes check inside a Tk callback, report CHECKED,
+then await a bounded byte on a dedicated pipe without servicing the Tk loop.
+The controller sends competing XTEST keys after CHECKED; an independent sender
+process must exit0 before the pipe is released. No-yield Undo runs before queued
+keys; yielding routes explicitly call update before Undo. Recheck revalidates
+all receipt fields after update and does not service events again before Undo.
+This barrier deliberately selects event ordering, not natural timing frequency.
+Early edit is y/F12 before the check; all routes must refuse. After-check insert
+is y/F12; ABA is y/F12/BackSpace/F12. After-commit edit is y/F12 only after a
+terminal operation response. Raw snapshots, all actual app history operations,
+keys, native-key requests, pipe messages, file bytes and process exits retained.
+The observer is read-only and does not author the candidate decision.
+
+## D
+Complete40, exact sources, strict identities, actual exits, empty keymaps/buttons,
+all rows retained, raw-only independent implementation/process audit required.
+Frozen final table (columns split/no-yield/yield/recheck):
+QUIET: base:p / base:p / base:p / base:p, all Undo.
+EARLY_EDIT: base:pxy in all, no Undo.
+AFTER_CHECK_INSERT: base:px / base:py / base:px / base:pxy.
+AFTER_CHECK_ABA: base:pxy / base:p / base:pxy / base:px.
+AFTER_COMMIT_INSERT: base:py in all, all Undo.
+For recheck two after-check rows are refused and unresolved. No-yield must
+actually apply pending native edits after Undo; suppressing or dropping them
+is a FAIL. Raw journal order must place competitor histories strictly between
+check/Undo in yielding+split cases and after Undo in no-yield cases. ABA must
+have exact text equality before the wrong Undo but different revision.
+PASS_COMPARE_UNDO_REENTRANCY_BOUNDARY_SCOPED only with all gates and at least8
+rehash-aware corruption rejections. Comparator wrong effects remain FAIL,
+not candidate success. Full unexpected science=FAIL; provenance/process/coverage
+ambiguity=HOLD/STOP. No postformal same-ID rerun or source/gate edit.
+
+## C
+Receipt/history producer is trusted and cooperative. History observer covers
+this proxy's completed insert/delete/replace/undo/redo/reset/separator commands.
+All mutation is on one Tk interpreter thread; observer callback logs but neither
+mutates nor pumps events. The atomicity scope is that serialization boundary,
+not GIL, OS-wide locking, arbitrary callbacks, other apps, crash durability or
+irreversible side effects. update is an explicit reentrancy control, not a claim
+that existing production code uses it. GUI admission/lease/model are not tested.
+
+## U and units
+Exact text, integer revision, event order and actual exits determine decisions.
+Two repeats per cell are coverage, not reliability estimates. Monotonic stamps
+are diagnostic integer nanoseconds within this container; no comparison to X
+millisecond event epoch and no calibrated uncertainty/coverage factor is claimed.
+Backend fixed at X11+Tk, ordinary Text key bindings and app-provided compare/undo.
+No latency, model token, resource benchmark, general GUI or runtime promotion.
+
+## Variables / fields
+| Field | Meaning (Japanese) | SI unit | Definition | Range / premise | Type |
+|---|---|---|---|---|---|
+| reference | 対象編集後の本文・履歴・識別記録 | 1 | fixed post-x/separator snapshot | same app lifecycle | record |
+| revision | 完了した履歴変更可能コマンドの番号 | 1 | proxy increments after successful command | nonnegative Python int, bool rejected | scalar integer |
+| text | 現在の本文 | 1 | Text get1.0 end-1c | bounded ASCII fixture | string |
+| session | 実験アプリ寿命の識別子 | 1 | unique case identity | exact match required | string |
+| mono_ns | 単調時計の観測値 | s (stored ns) | time.monotonic_ns() | one container clock | scalar integer |
+Dimension check: history comparisons use only dimensionless revision/identities;
+clock values are never compared with revision, and X event ms is never subtracted
+from monotonic ns. Outcome counts are dimensionless.
+
+## Public primary context
+Tcl8.6 update manual: https://www.tcl-lang.org/man/tcl8.6/TclCmd/update.htm
+Tk8.6 Text undo manual: https://www.tcl-lang.org/man/tcl8.6/TkCmd/text.htm
+These live manuals currently identify8.6.18; executed8.6.16 is separately pinned.
+Documentation motivates expected behavior; native results determine this verdict.
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/execute.py b/research/integration/undo_compare_commit_v1/construction-01-source/execute.py
new file mode 100644
index 0000000..96344a9
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/execute.py
@@ -0,0 +1,26 @@
+"""Bounded foreground supervisor; actual child exit or explicit timeout is retained."""
+import argparse, json, os, signal, subprocess, sys, time
+from pathlib import Path
+from support import dump
+ROOT=Path(__file__).resolve().parent
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--mode',choices=['construction','formal'],required=True);p.add_argument('--batch',type=int,required=True);p.add_argument('--name')
+    a=p.parse_args();name=a.name if a.mode=='construction' else f'formal-{a.batch}'
+    if not name or '/' in name or name in ['.','..']:raise ValueError('output name')
+    marker=ROOT/(name+'.invocation.json')
+    if a.mode=='formal' and a.batch==1:
+        prev=json.loads((ROOT/'formal-0.exit.json').read_text())
+        if prev['returncode']!=0 or prev['timed_out']:raise RuntimeError('previous formal batch incomplete')
+    cmd=[sys.executable,'-B',str(ROOT/'study.py'),'--mode',a.mode,'--batch',str(a.batch),'--out',str(ROOT/name)]
+    dump(marker,{'argv':cmd,'mono_ns':time.monotonic_ns(),'mode':a.mode,'batch':a.batch})
+    rec={'argv':cmd,'timed_out':False,'start_ns':time.monotonic_ns()}
+    with (ROOT/(name+'.stdout')).open('xb') as out,(ROOT/(name+'.stderr')).open('xb') as err:
+        proc=subprocess.Popen(cmd,stdout=out,stderr=err,start_new_session=True,env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1'))
+        rec['pid']=proc.pid
+        try:rec['returncode']=proc.wait(timeout=35)
+        except subprocess.TimeoutExpired:
+            rec['timed_out']=True;os.killpg(proc.pid,signal.SIGKILL);rec['returncode']=proc.wait(timeout=3)
+    rec['end_ns']=time.monotonic_ns();dump(ROOT/(name+'.exit.json'),rec)
+    print(json.dumps(rec,sort_keys=True));return int(rec['timed_out'] or rec['returncode']!=0)
+if __name__=='__main__':raise SystemExit(main())
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/fixture.py b/research/integration/undo_compare_commit_v1/construction-01-source/fixture.py
new file mode 100644
index 0000000..f87727c
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/fixture.py
@@ -0,0 +1,216 @@
+"""Private Tk Text; native bindings plus an explicit app-owned history observer.
+
+F12 separates undo groups; F11 clears the undo stack. These are declared app
+features, not stock key semantics. The Tcl proxy forwards all widget commands
+unchanged and observes only mutation-capable completed calls. No scenario label is delivered. IPC additionally exposes the explicitly
+cooperative conditional-Undo operation; mode selects its event-service contract.
+"""
+import argparse
+import hashlib
+import json
+import os
+import select
+from pathlib import Path
+import sys
+import time
+import tkinter as tk
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--session', required=True)
+    parser.add_argument('--permit-fd', type=int, required=True)
+    args = parser.parse_args()
+    journal = (args.out / 'app.jsonl').open('x', encoding='utf-8')
+    root = tk.Tk()
+    root.geometry('640x240+0+0')
+    root.title(args.session)
+    w = tk.Text(root, undo=True, autoseparators=True, maxundo=-1,
+                wrap='none', insertofftime=0, exportselection=False)
+    w.pack(fill='both', expand=True)
+    w.insert('1.0', 'base:')
+    w.mark_set('insert', 'end-1c')
+    w.edit_reset()
+    w.edit_modified(False)
+    state = {'revision': 0, 'seq': 0, 'keys': [], 'separators': 0,
+             'resets': 0, 'callback_errors': []}
+    native = w._w + '_native'
+    root.tk.call('rename', w._w, native)
+
+    def text():
+        return str(root.tk.call(native, 'get', '1.0', 'end-1c'))
+
+    def emit(event, **fields):
+        state['seq'] += 1
+        row = dict(event=event, seq=state['seq'], session=args.session,
+                   pid=os.getpid(), mono_ns=time.monotonic_ns(),
+                   revision=state['revision'], text=text(), **fields)
+        journal.write(json.dumps(row, sort_keys=True) + '\n')
+        journal.flush()
+        return row
+
+    def observe_command(code, parts, before, result):
+        fields = dict(parts=list(root.tk.splitlist(parts)), before=str(before))
+        if int(code) == 0:
+            state['revision'] += 1
+            emit('history_command', **fields)
+        else:
+            emit('command_error', error=str(result), **fields)
+
+    root.tk.createcommand('history_observe', observe_command)
+    # Tcl catch/return preserves native Tcl result and error options. Re-raising
+    # a TclError inside a Python widget-command callback does NOT preserve the
+    # class binding's caught-error semantics; construction-01 retains that bug.
+    root.tk.eval(r'''proc %s {args} {
+        set op [lindex $args 0]
+        set sub [lindex $args 1]
+        set mut [expr {$op in {insert delete replace} ||
+                     ($op eq "edit" && $sub in {undo redo reset separator})}]
+        if {$mut} {set before [%s get 1.0 end-1c]}
+        set status [catch {uplevel 1 [linsert $args 0 %s]} result options]
+        if {$mut} {history_observe $status $args $before $result}
+        return -options $options $result
+    }''' % (w._w, native, native))
+
+    def observe(e, direction):
+        state['keys'].append([direction, e.keysym, e.keycode])
+        emit('key', direction=direction, keysym=e.keysym, keycode=e.keycode,
+             state=e.state, server_time_ms=e.time)
+
+    w.bind('<KeyPress>', lambda e: observe(e, 'down'), add='+')
+    w.bind('<KeyRelease>', lambda e: observe(e, 'up'), add='+')
+
+    def separate(e):
+        observe(e, 'down')
+        w.edit_separator()
+        state['separators'] += 1
+        emit('separator_applied', separator_number=state['separators'])
+        return 'break'
+
+    def reset(e):
+        observe(e, 'down')
+        w.edit_reset()
+        state['resets'] += 1
+        emit('reset_applied', reset_number=state['resets'])
+        return 'break'
+
+    w.bind('<F12>', separate)
+    w.bind('<F11>', reset)
+
+    def exception(kind, value, tb):
+        state['callback_errors'].append(str(value))
+        emit('callback_error', error=str(value))
+    root.report_callback_exception = exception
+    root.update()
+    w.focus_force()
+    root.update()
+    bindings = {str(s): str(root.tk.call('bind', 'Text', s))
+                for s in root.tk.splitlist(root.tk.call('bind', 'Text'))}
+
+    def reply(obj):
+        print(json.dumps(dict(obj, session=args.session, pid=os.getpid(),
+                              mono_ns=time.monotonic_ns()), sort_keys=True), flush=True)
+
+    def snapshot(req):
+        contents = text()
+        record = emit('snapshot', request_id=req['id'])
+        reply(dict(event='snapshot', request_id=req['id'], text=contents,
+                   sha256=hashlib.sha256(contents.encode()).hexdigest(),
+                   revision=state['revision'], journal_seq=record['seq'],
+                   separators=state['separators'], resets=state['resets'],
+                   keys=list(state['keys']), callback_errors=list(state['callback_errors']),
+                   widget_xid=w.winfo_id(), focus=str(root.focus_get()),
+                   canundo=bool(root.tk.call(native, 'edit', 'canundo')),
+                   kind='APP_HISTORY_SNAPSHOT'))
+
+    def current_receipt():
+        contents = text()
+        return dict(kind='APP_HISTORY_SNAPSHOT', session=args.session,
+                    pid=os.getpid(), widget_xid=w.winfo_id(), revision=state['revision'],
+                    text=contents, sha256=hashlib.sha256(contents.encode()).hexdigest(),
+                    focus=str(root.focus_get()), separators=state['separators'])
+
+    def conditional_undo(req):
+        # Cooperative test API, not an ordinary or production Tk capability.
+        from policy import decide
+        mode = req['mode']
+        if mode not in ('INLINE_NO_YIELD', 'INLINE_YIELD', 'INLINE_RECHECK'):
+            raise ValueError('unknown inline route')
+        reference = req['reference']
+        owner = dict(session=args.session, pid=os.getpid(), widget_xid=w.winfo_id(),
+                     widget_path=str(w))
+        first = current_receipt()
+        decision = decide('HISTORY_CURRENT', reference, first, owner)
+        emit('compare', request_id=req['id'], mode=mode, receipt=first, decision=decision)
+        if not decision['admit']:
+            reply(dict(event='operation_result', request_id=req['id'], status='REFUSED',
+                       check=first, decision=decision, after=first, undo_invoked=False))
+            return
+        reply(dict(event='checked', request_id=req['id'], check=first, decision=decision))
+        # Explicit test barrier: wait without servicing Tcl events. Only the owned
+        # orchestrator writes this pipe. A timeout stops instead of running Undo.
+        if not select.select([args.permit_fd], [], [], 3)[0]:
+            raise TimeoutError('permit deadline')
+        if os.read(args.permit_fd, 1) != b'G':
+            raise ValueError('invalid permit')
+        emit('permit_received', request_id=req['id'])
+        if mode != 'INLINE_NO_YIELD':
+            emit('yield_begin', request_id=req['id'])
+            root.update()
+            emit('yield_end', request_id=req['id'])
+        second = current_receipt()
+        if mode == 'INLINE_RECHECK':
+            decision = decide('HISTORY_CURRENT', reference, second, owner)
+            emit('recheck', request_id=req['id'], receipt=second, decision=decision)
+            if not decision['admit']:
+                reply(dict(event='operation_result', request_id=req['id'], status='REFUSED',
+                           check=first, preundo=second, decision=decision,
+                           after=second, undo_invoked=False))
+                return
+        emit('undo_begin', request_id=req['id'], receipt=second)
+        # No update, wait, callback invocation or other Tk event service here.
+        # The widget proxy logs completed native commands but never pumps events.
+        w.edit_undo()
+        after = current_receipt()
+        emit('undo_end', request_id=req['id'], receipt=after)
+        reply(dict(event='operation_result', request_id=req['id'], status='APPLIED',
+                   check=first, preundo=second, after=after, undo_invoked=True))
+
+    def incoming(fd, mask):
+        line = sys.stdin.readline()
+        if not line:
+            root.destroy()
+            return
+        req = json.loads(line)
+        if req['op'] == 'conditional_undo':
+            conditional_undo(req)
+        elif req['op'] == 'snapshot':
+            # A bounded fixture fence, not a general background-task completion ACK.
+            root.after(12, lambda: snapshot(req))
+        elif req['op'] == 'close':
+            with (args.out / 'final.txt').open('xb') as f:
+                f.write(text().encode()); f.flush(); os.fsync(f.fileno())
+            emit('closing')
+            reply(dict(event='closing', request_id=req['id'], text=text()))
+            root.after_idle(root.destroy)
+        else:
+            raise ValueError('unknown cooperative fixture operation')
+    root.createfilehandler(sys.stdin, tk.READABLE, incoming)
+    emit('ready')
+    reply(dict(event='ready', widget_xid=w.winfo_id(), root_xid=root.winfo_id(),
+               widget_path=str(w), text=text(), class_bindings=bindings,
+               bindtags=list(w.bindtags()), tk_patchlevel=str(root.tk.call('package','provide','Tk')),
+               tcl_patchlevel=str(root.tk.call('info','patchlevel')),
+               undo_binding=str(root.tk.call('event','info','<<Undo>>')),
+               undo=bool(w.cget('undo')), autoseparators=bool(w.cget('autoseparators')),
+               tk_library=str(root.tk.call('set','tk_library'))))
+    try:
+        root.mainloop()
+    finally:
+        journal.close()
+    return 1 if state['callback_errors'] else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/input_sender.py b/research/integration/undo_compare_commit_v1/construction-01-source/input_sender.py
new file mode 100644
index 0000000..929ce70
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/input_sender.py
@@ -0,0 +1,16 @@
+"""Independent competitor: actual XTEST keys in the explicitly supplied display."""
+import argparse,json,os
+from support import Keys,state
+
+def main():
+    p=argparse.ArgumentParser(); p.add_argument('--display',required=True); p.add_argument('--keys',required=True)
+    a=p.parse_args(); names=json.loads(a.keys)
+    if names not in (['y','F12'],['y','F12','BackSpace','F12']): raise ValueError('unexpected private fixture sequence')
+    events=[]; k=Keys(a.display,events)
+    try:
+        before=state(k.d)
+        for name in names: k.tap(name)
+        after=state(k.d)
+    finally: k.close()
+    print(json.dumps({'pid':os.getpid(),'events':events,'before':before,'after':after},sort_keys=True))
+if __name__=='__main__': main()
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/policy.py b/research/integration/undo_compare_commit_v1/construction-01-source/policy.py
new file mode 100644
index 0000000..20ed9b6
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/policy.py
@@ -0,0 +1,35 @@
+"""Read-only evidence policy; cannot issue input or access the application."""
+import hashlib
+
+POLICIES = ('SCOPE_ONLY', 'TEXT_EQUAL', 'HISTORY_CURRENT')
+
+
+def decide(policy: str, reference: dict, current: dict, ready: dict) -> dict:
+    if policy not in POLICIES:
+        raise ValueError('unknown policy')
+    valid = True
+    for snap in (reference, current):
+        if type(snap) is not dict:
+            valid = False
+            break
+        valid &= (snap.get('kind') == 'APP_HISTORY_SNAPSHOT'
+                  and snap.get('session') == ready.get('session')
+                  and type(snap.get('pid')) is int and snap['pid'] == ready.get('pid')
+                  and type(snap.get('widget_xid')) is int
+                  and snap['widget_xid'] == ready.get('widget_xid')
+                  and type(snap.get('revision')) is int and snap['revision'] >= 0
+                  and type(snap.get('text')) is str
+                  and snap.get('focus') == ready.get('widget_path'))
+        if valid:
+            valid &= snap.get('sha256') == hashlib.sha256(snap['text'].encode()).hexdigest()
+    if not valid:
+        return {'admit': False, 'reason': 'INVALID_IDENTITY_OR_EVIDENCE'}
+    if reference.get('separators') != 2 or reference['text'] != 'base:px':
+        return {'admit': False, 'reason': 'INVALID_ORIGINAL_SCOPE'}
+    if policy == 'SCOPE_ONLY':
+        return {'admit': True, 'reason': 'ORIGINAL_SCOPE_MATCH'}
+    if current['sha256'] != reference['sha256']:
+        return {'admit': False, 'reason': 'TEXT_CHANGED'}
+    if policy == 'HISTORY_CURRENT' and current['revision'] != reference['revision']:
+        return {'admit': False, 'reason': 'HISTORY_CHANGED'}
+    return {'admit': True, 'reason': 'MATCH'}
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/study.py b/research/integration/undo_compare_commit_v1/construction-01-source/study.py
new file mode 100644
index 0000000..374d1b9
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/study.py
@@ -0,0 +1,109 @@
+"""First-outcome experiment. Scenario labels stay in this orchestrator only."""
+from __future__ import annotations
+import argparse,json,os,subprocess,sys,time
+from pathlib import Path
+from Xlib import display
+from policy import decide
+from support import Keys,state,call,send,recv,dump,sha,xserver
+ROOT=Path(__file__).resolve().parent
+ROUTES=['SPLIT_KEY','INLINE_NO_YIELD','INLINE_YIELD','INLINE_RECHECK']
+SCHEDULES=['QUIET','EARLY_EDIT','AFTER_CHECK_INSERT','AFTER_CHECK_ABA','AFTER_COMMIT_INSERT']
+
+def run_case(out,dname,route,schedule,index):
+    d=out/f'case-{index:02d}';d.mkdir()
+    cid=f'{out.name}-{index:02d}'
+    row={'case_id':cid,'route':route,'schedule':schedule,'ipc':[],'input':[],'competitors':[],'errors':[]}
+    permit_r,permit_w=os.pipe(); err=(d/'app.stderr').open('xb'); proc=None; keys=observer=None
+    try:
+        argv=[sys.executable,'-B',str(ROOT/'fixture.py'),'--out',str(d),'--session',cid,'--permit-fd',str(permit_r)]
+        row['app_argv']=argv; row['spawn_ns']=time.monotonic_ns()
+        proc=subprocess.Popen(argv,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=err,pass_fds=[permit_r],env=dict(os.environ,DISPLAY=dname,PYTHONDONTWRITEBYTECODE='1'))
+        os.close(permit_r);permit_r=None
+        row['ready']=recv(proc,row['ipc'],timeout=8)
+        if row['ready']['pid']!=proc.pid or row['ready']['session']!=cid: raise RuntimeError('ready identity')
+        keys=Keys(dname,row['input']); observer=display.Display(dname)
+        row['initial_server']=state(observer)
+        def snap(label):
+            r=call(proc,row['ipc'],'snapshot');row[label]=r
+            if r['callback_errors'] or r['focus']!=row['ready']['widget_path']: raise RuntimeError('app error/focus')
+            return r
+        if snap('initial')['text']!='base:': raise RuntimeError('baseline')
+        for key,label in [('p','protected'),('F12','start_group'),('x','task'),('F12','reference')]:
+            keys.tap(key);snap(label)
+        reference=row['reference']
+        def competitor(names):
+            argv=[sys.executable,'-B',str(ROOT/'input_sender.py'),'--display',dname,'--keys',json.dumps(names)]
+            r={'argv':argv,'before_ns':time.monotonic_ns()}
+            cp=subprocess.run(argv,capture_output=True,timeout=2,env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1'))
+            r.update(after_ns=time.monotonic_ns(),stdout=cp.stdout.decode(),stderr=cp.stderr.decode(),returncode=cp.returncode)
+            row['competitors'].append(r)
+            if cp.returncode or cp.stderr: raise RuntimeError('competitor failed')
+        if schedule=='EARLY_EDIT':
+            competitor(['y','F12']);snap('early_edit')
+        current=snap('client_check')
+        row['client_decision']=decide('HISTORY_CURRENT',reference,current,row['ready'])
+        changes={'AFTER_CHECK_INSERT':['y','F12'],'AFTER_CHECK_ABA':['y','F12','BackSpace','F12']}
+        if route=='SPLIT_KEY':
+            if row['client_decision']['admit']:
+                if schedule in changes: competitor(changes[schedule])
+                snap('preundo');row['undo_start_ns']=time.monotonic_ns();keys.undo()
+                row['undo_end_ns']=time.monotonic_ns();row['undo_invoked']=True
+            else: row['undo_invoked']=False
+            row['operation_result']=snap('operation_snapshot')
+        else:
+            i=send(proc,row['ipc'],'conditional_undo',reference=reference,mode=route)
+            res=recv(proc,row['ipc'])
+            if res.get('request_id')!=i: raise RuntimeError('operation ID')
+            if res['event']=='checked':
+                row['checked']=res
+                if schedule in changes: competitor(changes[schedule])
+                row['permit_ns']=time.monotonic_ns();os.write(permit_w,b'G')
+                res=recv(proc,row['ipc'])
+            if res.get('event')!='operation_result' or res.get('request_id')!=i: raise RuntimeError('operation result')
+            row['operation_result']=res;row['undo_invoked']=res['undo_invoked']
+        if schedule=='AFTER_COMMIT_INSERT': competitor(['y','F12'])
+        row['terminal']=snap('terminal_snapshot');row['final_server']=state(observer)
+    except Exception as e:
+        row['errors'].append(type(e).__name__+': '+str(e))
+    finally:
+        if keys is not None: keys.close()
+        if observer is not None:
+            row['cleanup_server']=state(observer);observer.close()
+        os.close(permit_w)
+        if permit_r is not None: os.close(permit_r)
+        if proc is not None:
+            try:
+                if proc.poll() is None: row['closing']=call(proc,row['ipc'],'close')
+                row['app_returncode']=proc.wait(timeout=3)
+            except Exception as e:
+                row['errors'].append('cleanup: '+str(e));proc.kill();row['app_returncode']=proc.wait(timeout=2)
+        err.close();dump(d/'row.json',row)
+    return row
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--mode',choices=['construction','formal'],required=True);p.add_argument('--batch',type=int,required=True);p.add_argument('--out',type=Path,required=True)
+    a=p.parse_args()
+    if a.mode=='formal':
+        if a.batch not in [0,1] or a.out.resolve()!=ROOT/f'formal-{a.batch}': raise ValueError('formal output/batch mismatch')
+        freeze=json.loads((ROOT/'FREEZE.json').read_text())
+        for name,h in freeze['sources'].items():
+            if sha(ROOT/name)!=h: raise RuntimeError('source mismatch '+name)
+        for name,h in json.loads((ROOT/'ENVIRONMENT.json').read_text())['files'].items():
+            if sha(Path(name))!=h: raise RuntimeError('environment mismatch '+name)
+    a.out.mkdir(exist_ok=False,parents=True)
+    result={'mode':a.mode,'batch':a.batch,'rows':[],'errors':[],'start_ns':time.monotonic_ns()}
+    try:
+        with xserver(a.out) as dname:
+            schedule=[(s,r) for s in SCHEDULES for r in ROUTES]
+            # Reverse routes on the second repetition; conditions and gates unchanged.
+            if a.batch==1: schedule=[(s,r) for s in SCHEDULES for r in reversed(ROUTES)]
+            for i,(s,r) in enumerate(schedule):
+                row=run_case(a.out,dname,r,s,i);result['rows'].append(row['case_id'])
+                if row['errors'] or row.get('app_returncode')!=0: raise RuntimeError('STOP_CASE '+row['case_id'])
+    except Exception as e: result['errors'].append(type(e).__name__+': '+str(e))
+    result['end_ns']=time.monotonic_ns();dump(a.out/'END.json',result)
+    manifest={str(p.relative_to(a.out)):sha(p) for p in sorted(a.out.rglob('*')) if p.is_file()}
+    dump(a.out/'MANIFEST.json',manifest)
+    print(json.dumps(result,sort_keys=True))
+    return bool(result['errors'])
+if __name__=='__main__': raise SystemExit(main())
diff --git a/research/integration/undo_compare_commit_v1/construction-01-source/support.py b/research/integration/undo_compare_commit_v1/construction-01-source/support.py
new file mode 100644
index 0000000..c465ae8
--- /dev/null
+++ b/research/integration/undo_compare_commit_v1/construction-01-source/support.py
@@ -0,0 +1,94 @@
+"""Owned private X server, bounded JSON pipe IO and native input instrumentation."""
+from __future__ import annotations
+import contextlib, hashlib, json, os, select, secrets, subprocess, sys, time
+from pathlib import Path
+from Xlib import X, XK, display
+from Xlib.ext import xtest
+MASK = X.Button1Mask|X.Button2Mask|X.Button3Mask|X.Button4Mask|X.Button5Mask
+
+def dump(path: Path, obj: object) -> None:
+    with path.open('x', encoding='utf-8') as f:
+        json.dump(obj, f, indent=2, sort_keys=True); f.write('\n')
+
+def sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def recv(proc, log: list, timeout: float = 3) -> dict:
+    end = time.monotonic()+timeout; buf = bytearray()
+    while len(buf) <= 150000:
+        left=end-time.monotonic()
+        if left<=0 or not select.select([proc.stdout], [], [], left)[0]:
+            raise TimeoutError('bounded response')
+        b=os.read(proc.stdout.fileno(),1)
+        if not b: raise RuntimeError('EOF before response')
+        buf.extend(b)
+        if b==b'\n':
+            text=buf.decode(); log.append({'direction':'receive','mono_ns':time.monotonic_ns(),'raw':text})
+            return json.loads(text)
+    raise ValueError('oversize response')
+
+def send(proc, log: list, op: str, **fields) -> int:
+    i=sum(r['direction']=='send' for r in log)
+    req={'op':op,'id':i,**fields}; raw=json.dumps(req,sort_keys=True)+'\n'
+    log.append({'direction':'send','mono_ns':time.monotonic_ns(),'raw':raw})
+    proc.stdin.write(raw.encode()); proc.stdin.flush(); return i
+
+def call(proc,log,op,**fields):
+    i=send(proc,log,op,**fields); r=recv(proc,log)
+    if r.get('request_id')!=i: raise RuntimeError('response ID mismatch')
+    return r
+
+def state(d):
+    d.sync(); pointer=d.screen().root.query_pointer()
+    focus=d.get_input_focus().focus
+    return dict(mono_ns=time.monotonic_ns(), keys=list(d.query_keymap()),
+                buttons=int(pointer.mask)&MASK, focus_xid=getattr(focus,'id',focus))
+
+class Keys:
+    def __init__(self,dname,log):
+        self.d=display.Display(dname); self.log=log; self.held=set()
+    def key(self,name,down):
+        code=self.d.keysym_to_keycode(XK.string_to_keysym(name))
+        if not code: raise ValueError('unmapped key '+name)
+        r={'keysym':name,'keycode':code,'down':down,'before_ns':time.monotonic_ns()}
+        if down: self.held.add(code)
+        xtest.fake_input(self.d,X.KeyPress if down else X.KeyRelease,detail=code)
+        self.d.sync()
+        if not down: self.held.discard(code)
+        r['after_ns']=time.monotonic_ns(); self.log.append(r)
+    def tap(self,name): self.key(name,True); self.key(name,False)
+    def undo(self):
+        self.key('Control_L',True); self.tap('z'); self.key('Control_L',False)
+    def close(self):
+        for code in self.held:
+            xtest.fake_input(self.d,X.KeyRelease,detail=code)
+        self.d.sync(); self.d.close()
+
+@contextlib.contextmanager
+def xserver(out: Path):
+    auth=out/'Xauthority'; auth.touch(mode=0o600); cookie=secrets.token_hex(16)
+    subprocess.run(['/usr/bin/xauth','-f',str(auth),'add',':12345','.',cookie],check=True,timeout=2)
+    r,w=os.pipe(); log=(out/'xvfb.stderr').open('xb'); proc=None
+    rec={'argv':['/usr/bin/Xvfb','-displayfd','FD','-screen','0','640x240x24','-nolisten','tcp','-noreset','-auth','PRIVATE_AUTH']}
+    old=os.environ.get('XAUTHORITY'); os.environ['XAUTHORITY']=str(auth)
+    try:
+        proc=subprocess.Popen(['/usr/bin/Xvfb','-displayfd',str(w),'-screen','0','640x240x24','-nolisten','tcp','-noreset','-auth',str(auth)],pass_fds=[w],stdout=subprocess.DEVNULL,stderr=log)
+        os.close(w); w=None; rec['pid']=proc.pid
+        if not select.select([r],[],[],5)[0]: raise TimeoutError('Xvfb readiness')
+        n=os.read(r,128).decode().strip()
+        if not n.isdigit(): raise ValueError('invalid display')
+        dname=':'+n; rec['display']=dname
+        subprocess.run(['/usr/bin/xauth','-f',str(auth),'add',dname,'.',cookie],check=True,timeout=2)
+        yield dname
+    finally:
+        if proc is not None:
+            proc.terminate()
+            try: rec['returncode']=proc.wait(timeout=3)
+            except subprocess.TimeoutExpired:
+                proc.kill(); rec['returncode']=proc.wait(timeout=2); rec['forced_kill']=True
+        log.close(); os.close(r)
+        if w is not None: os.close(w)
+        auth.unlink(missing_ok=True)
+        if old is None: os.environ.pop('XAUTHORITY',None)
+        else: os.environ['XAUTHORITY']=old
+        dump(out/'server_exit.json',rec)
