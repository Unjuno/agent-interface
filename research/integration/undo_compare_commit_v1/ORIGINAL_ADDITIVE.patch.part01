+    "request_id": 1,
+    "resets": 0,
+    "revision": 1,
+    "separators": 0,
+    "session": "construction-01-00",
+    "sha256": "82a853ef8520235bbd3c0f146eda32328ff8a438b0d04bec83820cee25811bf5",
+    "text": "base:p",
