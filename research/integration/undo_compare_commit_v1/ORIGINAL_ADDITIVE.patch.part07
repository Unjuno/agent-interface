+      "mono_ns": 596865560024,
+      "raw": "{\"autoseparators\": true, \"bindtags\": [\".!text\", \"Text\", \".\", \"all\"], \"class_bindings\": {\"<<Clear>>\": \"\\n    # Make <<Clear>> an atomic operation on the Undo stack,\\n    # i.e. separate it from other delete operations on either side\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n    catch {%W delete sel.first sel.last}\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n\", \"<<Copy>>\": \"\\n    tk_textCopy %W\\n\", \"<<Cut>>\": \"\\n    tk_textCut %W\\n\", \"<<LineEnd>>\": \"\\n    tk::TextSetCursor %W {insert display lineend}\\n\", \"<<LineStart>>\": \"\\n    tk::TextSetCursor %W {insert display linestart}\\n\", \"<<NextChar>>\": \"\\n    tk::TextSetCursor %W insert+1displayindices\\n\", \"<<NextLine>>\": \"\\n    tk::TextSetCursor %W [tk::TextUpDownLine %W 1]\\n\", \"<<NextPara>>\": \"\\n    tk::TextSetCursor %W [tk::TextNextPara %W insert]\\n\", \"<<NextWord>>\": \"\\n    tk::TextSetCursor %W [tk::TextNextWord %W insert]\\n\", \"<<Paste>>\": \"\\n    tk_textPaste %W\\n\", \"<<PasteSelection>>\": \"\\n    if {$tk_strictMotif || ![info exists tk::Priv(mouseMoved)]\\n\\t    || !$tk::Priv(mouseMoved)} {\\n\\ttk::TextPasteSelection %W %x %y\\n    }\\n\", \"<<PrevChar>>\": \"\\n    tk::TextSetCursor %W insert-1displayindices\\n\", \"<<PrevLine>>\": \"\\n    tk::TextSetCursor %W [tk::TextUpDownLine %W -1]\\n\", \"<<PrevPara>>\": \"\\n    tk::TextSetCursor %W [tk::TextPrevPara %W insert]\\n\", \"<<PrevWord>>\": \"\\n    tk::TextSetCursor %W [tk::TextPrevPos %W insert tcl_startOfPreviousWord]\\n\", \"<<Redo>>\": \"\\n    catch { %W edit redo }\\n\", \"<<SelectAll>>\": \"\\n    %W tag add sel 1.0 end\\n\", \"<<SelectLineEnd>>\": \"\\n    tk::TextKeySelect %W {insert display lineend}\\n\", \"<<SelectLineStart>>\": \"\\n    tk::TextKeySelect %W {insert display linestart}\\n\", \"<<SelectNextChar>>\": \"\\n    tk::TextKeySelect %W [%W index {insert + 1displayindices}]\\n\", \"<<SelectNextLine>>\": \"\\n    tk::TextKeySelect %W [tk::TextUpDownLine %W 1]\\n\", \"<<SelectNextPara>>\": \"\\n    tk::TextKeySelect %W [tk::TextNextPara %W insert]\\n\", \"<<SelectNextWord>>\": \"\\n    tk::TextKeySelect %W [tk::TextNextWord %W insert]\\n\", \"<<SelectNone>>\": \"\\n    %W tag remove sel 1.0 end\\n    # An operation that clears the selection must insert an autoseparator,\\n    # because the selection operation may have moved the insert mark\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n\", \"<<SelectPrevChar>>\": \"\\n    tk::TextKeySelect %W [%W index {insert - 1displayindices}]\\n\", \"<<SelectPrevLine>>\": \"\\n    tk::TextKeySelect %W [tk::TextUpDownLine %W -1]\\n\", \"<<SelectPrevPara>>\": \"\\n    tk::TextKeySelect %W [tk::TextPrevPara %W insert]\\n\", \"<<SelectPrevWord>>\": \"\\n    tk::TextKeySelect %W [tk::TextPrevPos %W insert tcl_startOfPreviousWord]\\n\", \"<<TkAccentBackspace>>\": \"\\n    %W delete insert-1c\\n\", \"<<TkClearIMEMarkedText>>\": \"\\n    %W delete IMEmarkedtext.first IMEmarkedtext.last\\n\", \"<<TkEndIMEMarkedText>>\": \"\\n    if { [catch {dict get $::tk::Priv(IMETextMark) \\\"%W\\\"} mark] } {\\n\\tbell\\n    } else {\\n\\t%W tag add IMEmarkedtext $mark insert\\n\\t%W tag configure IMEmarkedtext -underline on\\n    }\\n\", \"<<TkStartIMEMarkedText>>\": \"\\n    dict set ::tk::Priv(IMETextMark) \\\"%W\\\" [%W index insert]\\n\", \"<<Undo>>\": \"\\n    # An Undo operation may remove the separator at the top of the Undo stack.\\n    # Then the item at the top of the stack gets merged with the subsequent changes.\\n    # Place separators before and after Undo to prevent this.\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n    catch { %W edit undo }\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n\", \"<Alt-Key>\": \"# nothing \", \"<B1-Enter>\": \"\\n    tk::CancelRepeat\\n\", \"<B1-Leave>\": \"\\n    set tk::Priv(x) %x\\n    set tk::Priv(y) %y\\n    tk::TextAutoScan %W\\n\", \"<B1-Motion>\": \"\\n    set tk::Priv(x) %x\\n    set tk::Priv(y) %y\\n    tk::TextSelectTo %W %x %y\\n\", \"<B2-Motion>\": \"\\n        if {!$tk_strictMotif} {\\n        tk::TextScanDrag %W %x %y\\n        }\\n    \", \"<Button-1>\": \"\\n    tk::TextButton1 %W %x %y\\n    %W tag remove sel 0.0 end\\n\", \"<Button-2>\": \"\\n        if {!$tk_strictMotif} {\\n        tk::TextScanMark %W %x %y\\n        }\\n    \", \"<Button-4>\": \"\\n\\tif {!$tk_strictMotif} {\\n\\t    %W yview scroll -50 pixels\\n\\t}\\n    \", \"<Button-5>\": \"\\n\\tif {!$tk_strictMotif} {\\n\\t    %W yview scroll 50 pixels\\n\\t}\\n    \", \"<ButtonRelease-1>\": \"\\n    tk::CancelRepeat\\n\", \"<Control-B1-Motion>\": \" # nothing \", \"<Control-Button-1>\": \"\\n    %W mark set insert @%x,%y\\n    # An operation that moves the insert mark without making it\\n    # one end of the selection must insert an autoseparator\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n\", \"<Control-Key-End>\": \"\\n    tk::TextSetCursor %W {end - 1 indices}\\n\", \"<Control-Key-Home>\": \"\\n    tk::TextSetCursor %W 1.0\\n\", \"<Control-Key-Next>\": \"\\n    %W xview scroll 1 page\\n\", \"<Control-Key-Prior>\": \"\\n    %W xview scroll -1 page\\n\", \"<Control-Key-Tab>\": \"\\n    focus [tk_focusNext %W]\\n\", \"<Control-Key-d>\": \"\\n    if {!$tk_strictMotif && [%W compare end != insert+1c]} {\\n\\t%W delete insert\\n    }\\n\", \"<Control-Key-h>\": \"\\n    if {!$tk_strictMotif && [%W compare insert != 1.0]} {\\n\\t%W delete insert-1c\\n\\t%W see insert\\n    }\\n\", \"<Control-Key-i>\": \"\\n    tk::TextInsert %W \\\\t\\n\", \"<Control-Key-k>\": \"\\n    if {!$tk_strictMotif && [%W compare end != insert+1c]} {\\n\\tif {[%W compare insert == {insert lineend}]} {\\n\\t    %W delete insert\\n\\t} else {\\n\\t    %W delete insert {insert lineend}\\n\\t}\\n    }\\n\", \"<Control-Key-o>\": \"\\n    if {!$tk_strictMotif} {\\n\\t%W insert insert \\\\n\\n\\t%W mark set insert insert-1c\\n    }\\n\", \"<Control-Key-space>\": \"\\n    %W mark set [tk::TextAnchor %W] insert\\n\", \"<Control-Key-t>\": \"\\n    if {!$tk_strictMotif} {\\n\\ttk::TextTranspose %W\\n    }\\n\", \"<Control-Key>\": \"# nothing\", \"<Control-Shift-Key-End>\": \"\\n    tk::TextKeySelect %W {end - 1 indices}\\n\", \"<Control-Shift-Key-Home>\": \"\\n    tk::TextKeySelect %W 1.0\\n\", \"<Control-Shift-Key-Tab>\": \"\\n    focus [tk_focusPrev %W]\\n\", \"<Control-Shift-Key-space>\": \"\\n    set tk::Priv(selectMode) char\\n    tk::TextKeyExtend %W insert\\n\", \"<Double-Button-1>\": \"\\n    set tk::Priv(selectMode) word\\n    tk::TextSelectTo %W %x %y\\n    catch {%W mark set insert sel.first}\\n\", \"<Double-Control-Button-1>\": \" # nothing \", \"<Double-Shift-Button-1>\": \"\\n    set tk::Priv(selectMode) word\\n    tk::TextSelectTo %W %x %y 1\\n\", \"<Key-BackSpace>\": \"\\n    if {[tk::TextCursorInSelection %W]} {\\n\\t%W delete sel.first sel.last\\n    } else {\\n\\tif {[%W compare insert != 1.0]} {\\n\\t    %W delete insert-1c\\n\\t}\\n\\t%W see insert\\n    }\\n\", \"<Key-Delete>\": \"\\n    if {[tk::TextCursorInSelection %W]} {\\n\\t%W delete sel.first sel.last\\n    } else {\\n\\tif {[%W compare end != insert+1c]} {\\n\\t    %W delete insert\\n\\t}\\n\\t%W see insert\\n    }\\n\", \"<Key-Escape>\": \"# nothing\", \"<Key-Insert>\": \"\\n    catch {tk::TextInsert %W [::tk::GetSelection %W PRIMARY]}\\n\", \"<Key-KP_Enter>\": \"# nothing\", \"<Key-Next>\": \"\\n    tk::TextSetCursor %W [tk::TextScrollPages %W 1]\\n\", \"<Key-Prior>\": \"\\n    tk::TextSetCursor %W [tk::TextScrollPages %W -1]\\n\", \"<Key-Return>\": \"\\n    tk::TextInsert %W \\\\n\\n    if {[%W cget -autoseparators]} {\\n\\t%W edit separator\\n    }\\n\", \"<Key-Select>\": \"\\n    %W mark set [tk::TextAnchor %W] insert\\n\", \"<Key-Tab>\": \"\\n    if {[%W cget -state] eq \\\"normal\\\"} {\\n\\ttk::TextInsert %W \\\\t\\n\\tfocus %W\\n\\tbreak\\n    }\\n\", \"<Key>\": \"\\n    tk::TextInsert %W %A\\n\",