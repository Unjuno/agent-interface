{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-interface/live-adapter-authority-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "scope", "owner", "provider", "fixture", "effect_scorer", "release", "source_identities"],
  "properties": {
    "schema": {"const": "agent-interface/live-adapter-authority-receipt-v1"},
    "status": {"enum": ["DECLARED", "ABSENT", "EXPIRED", "REJECTED"]},
    "scope": {"type": "string", "minLength": 1},
    "owner": {"type": "object", "additionalProperties": false, "required": ["principal", "purpose"], "properties": {
      "principal": {"type": "string", "minLength": 1},
      "purpose": {"type": "string", "minLength": 1}
    }},
    "provider": {"type": "object", "additionalProperties": false, "required": ["name", "model", "effort"], "properties": {
      "name": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "effort": {"type": "string", "minLength": 1}
    }},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["kind", "disposable", "display_scope"], "properties": {
      "kind": {"const": "linux-x11-chromium"},
      "disposable": {"const": true},
      "display_scope": {"type": "string", "minLength": 1}
    }},
    "effect_scorer": {"type": "object", "additionalProperties": false, "required": ["independent", "retention"], "properties": {
      "independent": {"const": true},
      "retention": {"type": "string", "minLength": 1}
    }},
    "release": {"type": "object", "additionalProperties": false, "required": ["owner", "verified"], "properties": {
      "owner": {"type": "string", "minLength": 1},
      "verified": {"type": "boolean"}
    }},
    "source_identities": {"type": "object", "additionalProperties": false, "required": ["preflight_commit", "preflight_status"], "properties": {
      "preflight_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "preflight_status": {"const": "PASS_PRECHECK_HOLD_NO_MODEL_AUTHORITY"}
    }}
  }
}
