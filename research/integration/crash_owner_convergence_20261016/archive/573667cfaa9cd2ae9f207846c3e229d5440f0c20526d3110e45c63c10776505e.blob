#!/usr/bin/env python3
import hashlib,json,pathlib
root=pathlib.Path(__file__).resolve().parents[1]; f=json.loads((root/'FREEZE.json').read_text()); r=json.loads((root/'results/A01/RAW.json').read_text()); close=r.get('owner_release_record')
checks={'source_hashes_match':all(hashlib.sha256((root/'SOURCE'/n).read_bytes()).hexdigest()==h for n,h in f['source_sha256'].items()),'candidate_hash_matches_freeze':hashlib.sha256((root/'SOURCE/candidate.py').read_bytes()).hexdigest()==f['candidate_sha256'],'candidate_completed_clean_xvfb':r.get('status')=='CANDIDATE_COMPLETE' and not r.get('errors') and r.get('cleanup',{}).get('xvfb_exit')==0,'executor_sigkill_active_down':r.get('worker_returncode')==-9 and r.get('key_down_before_kill') is True,'supervisor_observed_eof':any(x.get('event')=='executor_channel_eof' for x in (r.get('supervisor_events') or [])),'owner_release_record_verified':isinstance(close,dict) and close.get('verified') is True and close.get('keys_down')==[],'x_keymap_up_after_close':r.get('key_up_after_owner_close') is True,'independent_keyrelease_event_observed':isinstance(r.get('key_release_after_kill'),dict) and r['key_release_after_kill'].get('type')==3,'owner_thread_stopped':r.get('owner_thread_stopped') is True and r.get('owner_thread_alive') is False}
out={'schema':'v39-executor-hardkill-supervised-a03-audit-v1','decision':'PASS_METHOD_SCOPED' if all(checks.values()) else 'STOP','checks':checks,'candidate_errors':r.get('errors'),'raw_key_up_after_owner_close':r.get('key_up_after_owner_close'),'raw_key_release_event':r.get('key_release_after_kill'),'observer_source_mask_line':'candidate.py uses event_mask=sum(types), where types are X event numbers, not X KeyPressMask/KeyReleaseMask'}; (root/'AUDITOR/audit.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n'); print(json.dumps(out,sort_keys=True))
