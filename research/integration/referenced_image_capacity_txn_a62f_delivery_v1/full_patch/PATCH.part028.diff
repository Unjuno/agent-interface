@@ -0,0 +1,31 @@
+"""Bounded foreground supervisor; captures a direct child's actual wait status."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+ROOT=Path(__file__).resolve().parent
+out=Path(sys.argv[1]);rep=int(sys.argv[2]);phase=sys.argv[3]
+if phase=='formal':
+    frozen=json.loads((ROOT/'FREEZE.json').read_bytes())
+    for name,expected in frozen['sha256'].items():
+        if hashlib.sha256((ROOT/name).read_bytes()).hexdigest()!=expected:raise SystemExit('SOURCE_DRIFT:'+name)
+out.mkdir(parents=True,exist_ok=False)
+(out/'CONSUMED').write_text('Single allocated batch. Never rerun or replace.\n')
+args=[sys.executable,'-I','-S','-B',str(ROOT/'run.py'),str(out),str(rep),phase]
+start=time.monotonic_ns();timeout=False
+with (out/'runner.stdout').open('xb') as stdout,(out/'runner.stderr').open('xb') as stderr:
+    p=subprocess.Popen(args,cwd=ROOT,stdin=subprocess.DEVNULL,stdout=stdout,stderr=stderr,start_new_session=True)
+    try:p.wait(timeout=20)
+    except subprocess.TimeoutExpired:
+        timeout=True;os.killpg(p.pid,signal.SIGKILL);p.wait()
+r={'argv':args,'pid':p.pid,'supervisor_pid':os.getpid(),'returncode':p.returncode,'timeout':timeout,
+   'started_ns':start,'finished_ns':time.monotonic_ns(),
+   'stdout_sha256':hashlib.sha256((out/'runner.stdout').read_bytes()).hexdigest(),
+   'stderr_sha256':hashlib.sha256((out/'runner.stderr').read_bytes()).hexdigest()}
+(out/'EXECUTION.json').write_text(json.dumps(r,sort_keys=True)+'\n')
+print(json.dumps(r,sort_keys=True))
+raise SystemExit(0 if p.returncode==0 and not timeout else 2)
