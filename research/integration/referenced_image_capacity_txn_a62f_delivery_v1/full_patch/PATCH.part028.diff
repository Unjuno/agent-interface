+"""Separate read-only observer; does not import the host implementation."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import sys
+
+p = Path(sys.argv[1])
+before = p.read_bytes()
+c = sqlite3.connect(p.as_uri() + '?mode=ro', uri=True)
+try:
+    result = {'cursor': json.loads(c.execute('SELECT payload FROM cursor WHERE id=1').fetchone()[0]),
+              'notifications': [json.loads(x[0]) for x in c.execute('SELECT body FROM notifications ORDER BY seq')],
+              'pages': [{'last_sequence': n, 'response': json.loads(b), 'response_sha256': hashlib.sha256(b).hexdigest()}
+                        for n, b in c.execute('SELECT last_sequence,response FROM pages ORDER BY last_sequence')],
+              'images': [{'sha': s, 'bytes': len(b), 'actual_sha256': hashlib.sha256(b).hexdigest()}
+                         for s, b in c.execute('SELECT sha,data FROM images ORDER BY sha')],
+              'integrity': c.execute('PRAGMA integrity_check').fetchone()[0],
+              'page_size': c.execute('PRAGMA page_size').fetchone()[0],
+              'page_count': c.execute('PRAGMA page_count').fetchone()[0], 'pid': os.getpid(),
+              'db_sha256': hashlib.sha256(before).hexdigest()}
+finally:
+    c.close()
+assert before == p.read_bytes(), 'OBSERVER_MUTATION'
+print(json.dumps(result, sort_keys=True))
