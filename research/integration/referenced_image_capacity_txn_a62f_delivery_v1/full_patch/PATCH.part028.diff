+"""Finite copied-evidence mutations; executes no retention or allocation."""
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sqlite3
+import sys
+ROOT=Path(__file__).resolve().parent
+sys.path.insert(0,str(ROOT))
+import audit
+
+
+def encode(v):return (json.dumps(v,sort_keys=True)+'\n').encode()
+
+
+def exercise(root,phase,reps):
+    rows=[];content={}
+    for rep in reps:
+        p=root/'evidence'/f'{phase}-r{rep}'
+        for line in (p/'RAW.jsonl').read_bytes().splitlines():
+            row=json.loads(line);rows.append(row)
+            content[row['case_id']]={n:(p/row['case_id']/n).read_bytes() for n in row['files']}
+    def verify(rs,fs):return audit.inspect_rows(rs,phase,reps,lambda row,name:fs[row['case_id']][name])
+    verify(rows,content)
+    targets={}
+    for i,row in enumerate(rows):targets.setdefault((row['condition'],row['policy']),i)
+    full=targets[('FULL_FIRST','ATOMIC_PAGE')];second=targets[('FULL_SECOND','ATOMIC_PAGE')];room=targets[('ROOM','ATOMIC_PAGE')]
+    def write(rs,fs,i,name,b):
+        row=rs[i];fs[row['case_id']][name]=b;row['files'][name]={'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
+        for c in row['calls']:
+            if name in (c['name']+'.stdout',c['name']+'.stderr'):
+                c[('stdout' if name.endswith('.stdout') else 'stderr')+'_sha256']=hashlib.sha256(b).hexdigest()
+        pb=encode(row['calls']);fs[row['case_id']]['processes.partial.json']=pb
+        row['files']['processes.partial.json']={'bytes':len(pb),'sha256':hashlib.sha256(pb).hexdigest()}
+    def mutate(rs,fs,kind):
+        if kind=='missing_case':rs.pop();return
+        if kind=='duplicate_case':rs[-1]=copy.deepcopy(rs[0]);return
+        if kind=='boolean_repetition':rs[0]['rep']=True;return
+        if kind=='missing_exit':del rs[full]['calls'][5]['returncode'];return
+        if kind=='false_storage_success':
+            r=json.loads(fs[rs[full]['case_id']]['retain_first.stdout']);r['status']='RETAINED'
+            write(rs,fs,full,'retain_first.stdout',encode(r));rs[full]['first_status']='RETAINED';return
+        if kind=='wrong_native_error':
+            r=json.loads(fs[rs[full]['case_id']]['retain_first.stdout']);r['error']['code']=5;r['error']['name']='SQLITE_BUSY'
+            write(rs,fs,full,'retain_first.stdout',encode(r));return
+        if kind=='wrong_capacity':
+            r=json.loads(fs[rs[full]['case_id']]['retain_first.stdout']);r['steps'][0]['max_page_count']=64
+            write(rs,fs,full,'retain_first.stdout',encode(r));return
+        if kind=='missing_partial_stage':
+            r=json.loads(fs[rs[second]['case_id']]['retain_first.stdout']);r['steps']=[s for s in r['steps'] if s['operation']!='image_staged']
+            write(rs,fs,second,'retain_first.stdout',encode(r));return
+        if kind in ('advanced_failed_cursor','lost_old_image'):
+            i=full if kind=='advanced_failed_cursor' else room;row=rs[i];f=fs[row['case_id']];c=sqlite3.connect(':memory:');c.deserialize(f['after_first.db'])
+            if kind=='advanced_failed_cursor':
+                cur=json.loads(f['first.stdout'])['next_cursor'];c.execute('UPDATE cursor SET payload=?',(encode(cur),))
+            else:c.execute('DELETE FROM images WHERE sha=?',(json.loads(f['initial.stdout'])['records'][0]['image_sha256'],))
+            c.commit();db=c.serialize();c.close();write(rs,fs,i,'after_first.db',db)
+            o=json.loads(f['after_first.stdout']);o['db_sha256']=hashlib.sha256(db).hexdigest()
+            if kind=='advanced_failed_cursor':o['cursor']=cur
+            else:o['images']=[a for a in o['images'] if a['sha']!=json.loads(f['initial.stdout'])['records'][0]['image_sha256']]
+            write(rs,fs,i,'after_first.stdout',encode(o));return
+        raise ValueError(kind)
+    names=['missing_case','duplicate_case','boolean_repetition','missing_exit','false_storage_success',
+           'wrong_native_error','wrong_capacity','missing_partial_stage','advanced_failed_cursor','lost_old_image']
+    rejected=[]
+    for name in names:
+        rs=copy.deepcopy(rows);fs=copy.deepcopy(content);mutate(rs,fs,name)
+        try:verify(rs,fs)
+        except (ValueError,KeyError,TypeError,IndexError,sqlite3.DatabaseError):rejected.append(name)
+        else:raise AssertionError('ACCEPTED_MUTATION:'+name)
+    return {'status':'PASS_COPIED_EVIDENCE_CONTROLS','baseline_cases':len(rows),'rejected_count':len(rejected),'rejected':rejected,'formal_cases_executed':0}
+
+
+if __name__=='__main__':
+    print(json.dumps(exercise(Path(sys.argv[1]),sys.argv[2],list(map(int,sys.argv[3:]))),indent=2,sort_keys=True))
