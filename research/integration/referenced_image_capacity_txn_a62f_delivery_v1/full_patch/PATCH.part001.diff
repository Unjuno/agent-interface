+"""One predetermined six-case batch; never relaunch a consumed output path."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+ROOT = Path(__file__).resolve().parent
+
+
+def enc(v): return (json.dumps(v, sort_keys=True, allow_nan=False) + '\n').encode()
+def digest(b): return hashlib.sha256(b).hexdigest()
+
+
+def run_case(d, policy, condition, rep, phase):
+    d.mkdir(exist_ok=False)
+    calls=[]
+    def call(name, argv, cwd=ROOT, codes=(0,)):
+        start=time.monotonic_ns()
+        p=subprocess.Popen(list(map(str,argv)), cwd=cwd, stdin=subprocess.DEVNULL,
+                           stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                           env={'PATH':os.defpath,'PYTHONDONTWRITEBYTECODE':'1','PYTHONNOUSERSITE':'1'})
+        timeout=False
+        try: out,err=p.communicate(timeout=3)
+        except subprocess.TimeoutExpired:
+            timeout=True;p.kill();out,err=p.communicate()
+        (d/(name+'.stdout')).write_bytes(out);(d/(name+'.stderr')).write_bytes(err)
+        receipt={'name':name,'argv':list(map(str,argv)),'cwd':str(cwd),'pid':p.pid,
+                 'returncode':p.returncode,'timeout':timeout,'started_ns':start,'finished_ns':time.monotonic_ns(),
+                 'stdout_sha256':digest(out),'stderr_sha256':digest(err)}
+        calls.append(receipt);(d/'processes.partial.json').write_bytes(enc(calls))
+        if timeout or p.returncode not in codes or err:raise RuntimeError('CHILD_FAILURE:'+name)
+        return json.loads(out)
+    def worker(name, op, *args, codes=(0,)):
+        return call(name,[sys.executable,'-I','-S','-B',ROOT/'worker.py',op,d,*args],codes=codes)
+    def read(name, cursor=None, count=2):
+        args=[sys.executable,'-S','-B','-m','research.integration.event_inbox_reader_v1',
+              '--stream',d/'stream.jsonl','--stream-id',d.name,'--max-records',str(count)]
+        if cursor is not None:
+            f=d/(name+'.cursor.json');f.write_bytes(enc(cursor));args+=['--cursor',f]
+        return call(name,args,ROOT/'upstream')
+    def observe(name):
+        r=call(name,[sys.executable,'-I','-S','-B',ROOT/'observe.py',d/'store.db'])
+        (d/(name+'.db')).write_bytes((d/'store.db').read_bytes())
+        if r['db_sha256']!=digest((d/(name+'.db')).read_bytes()):raise RuntimeError('SNAPSHOT_BINDING')
+        return r
+    worker('create','create')
+    read('initial',count=1)
+    worker('initialize','initialize')
+    before=observe('before')
+    read('first',before['cursor'])
+    first=worker('retain_first','retain',policy,condition,'first',codes=(0,2))
+    middle=observe('after_first')
+    # One predeclared storage-recovery phase: explicit larger quota, fresh read from the saved cursor.
+    # This is no action dispatch, automatic retry, or new scientific allocation.
+    read('recovery',middle['cursor'])
+    recovery=worker('retain_recovery','retain',policy,condition,'recovery')
+    final=observe('after_recovery')
+    read('tail',final['cursor'])
+    files={p.name:{'bytes':p.stat().st_size,'sha256':digest(p.read_bytes())} for p in sorted(d.iterdir()) if p.is_file()}
+    return {'case_id':d.name,'policy':policy,'condition':condition,'rep':rep,'phase':phase,
+            'calls':calls,'files':files,'first_status':first['status'],'recovery_status':recovery['status']}
+
+
+if __name__=='__main__':
+    output=Path(sys.argv[1]);rep=int(sys.argv[2]);phase=sys.argv[3]
+    if (output/'RAW.jsonl').exists():raise SystemExit('CONSUMED_OUTPUT')
+    with (output/'RAW.jsonl').open('xb') as f:
+        for condition in ('ROOM','FULL_FIRST','FULL_SECOND'):
+            policies=('META_THEN_OBJECTS','ATOMIC_PAGE') if rep%2 else ('ATOMIC_PAGE','META_THEN_OBJECTS')
+            for policy in policies:
+                d=output/f'{phase}-r{rep}-{condition}-{policy}'
+                row=run_case(d,policy,condition,rep,phase)
+                f.write(enc(row));f.flush();os.fsync(f.fileno())
+    print(json.dumps({'status':'COMPLETED_UNSCORED','cases':6,'phase':phase,'rep':rep,
+                      'raw_sha256':digest((output/'RAW.jsonl').read_bytes())},sort_keys=True))
