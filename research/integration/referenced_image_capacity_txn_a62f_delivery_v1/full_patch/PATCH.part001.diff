+"""Raw-only reconstruction, separate implementation; imports no study/worker code."""
+from __future__ import annotations
+import hashlib
+import json
+from pathlib import Path
+import sqlite3
+import struct
+import sys
+import zlib
+
+
+def need(ok, message):
+    if not ok: raise ValueError(message)
+
+
+def eq(a, b, message):
+    need(json.dumps(a,sort_keys=True,allow_nan=False)==json.dumps(b,sort_keys=True,allow_nan=False),message)
+
+
+def sha(b): return hashlib.sha256(b).hexdigest()
+
+
+def png_check(data, width, height, salt):
+    need(data[:8]==b'\x89PNG\r\n\x1a\n','PNG signature')
+    at=8;chunks=[]
+    while at<len(data):
+        n=struct.unpack('>I',data[at:at+4])[0];kind=data[at+4:at+8];body=data[at+8:at+8+n]
+        need(at+12+n<=len(data),'PNG extent')
+        need(zlib.crc32(kind+body)==struct.unpack('>I',data[at+8+n:at+12+n])[0],'PNG CRC')
+        chunks.append((kind,body));at+=12+n
+    need([k for k,_ in chunks]==[b'IHDR',b'IDAT',b'IEND'],'PNG chunk schema')
+    need(chunks[0][1]==struct.pack('>IIBBBBB',width,height,8,2,0,0,0),'PNG header')
+    pixels=zlib.decompress(chunks[1][1]);need(len(pixels)==height*(1+width*3),'PNG pixel count')
+    for y in range(height):
+        row=pixels[y*(1+width*3):(y+1)*(1+width*3)]
+        need(row[0]==0,'PNG filter')
+        expected=b''.join(hashlib.sha256(f'{salt}:{y}:{i}'.encode()).digest() for i in range((width*3+31)//32))[:width*3]
+        need(row[1:]==expected,'PNG deterministic pixels')
+
+
+def db_state(b):
+    c=sqlite3.connect(':memory:')
+    try:
+        c.deserialize(b)
+        need(c.execute('PRAGMA integrity_check').fetchone()[0]=='ok','SQLite integrity')
+        schema={r[0] for r in c.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+        need(schema=={'cursor','notifications','images','pages'},'DB schema')
+        cursorrows=c.execute('SELECT id,payload FROM cursor').fetchall()
+        need(len(cursorrows)==1 and cursorrows[0][0]==1,'cursor cardinality')
+        images=dict(c.execute('SELECT sha,data FROM images'))
+        for k,v in images.items():need(sha(v)==k,'stored image digest')
+        return {'cursor':json.loads(cursorrows[0][1]),
+                'notifications':[(n,json.loads(body),digest) for n,body,digest in c.execute('SELECT * FROM notifications ORDER BY seq')],
+                'pages':list(c.execute('SELECT * FROM pages ORDER BY last_sequence')),
+                'images':images,'page_count':c.execute('PRAGMA page_count').fetchone()[0],
+                'page_size':c.execute('PRAGMA page_size').fetchone()[0]}
+    finally:c.close()
+
+
+def cursor(stream, count, epoch):
+    prefix=b''.join(stream.splitlines(keepends=True)[:count])
+    return {'schema':'agent-interface/experimental-read-cursor-v1','stream_id':epoch,
+            'offset':len(prefix),'prefix_sha256':sha(prefix),'next_sequence':count+1}
+
+
+def response_check(r, records, expected_cursor, tail):
+    eq(r,{'schema':'agent-interface/experimental-inbox-read-v1','records':records,
+          'next_cursor':expected_cursor,'tail_state':tail,'problem':None,
+          'authority':'none','acknowledged':False,'input_dispatched':False},'reader response')
+
+
+def check_case(row, read):
+    policy=row['policy'];condition=row['condition'];phase=row['phase'];rep=row['rep'];case=row['case_id']
+    need(type(rep) is int,'rep type');eq(case,f'{phase}-r{rep}-{condition}-{policy}','case identity')
+    need(policy in ('META_THEN_OBJECTS','ATOMIC_PAGE') and condition in ('ROOM','FULL_FIRST','FULL_SECOND'),'cell')
+    for name,meta in row['files'].items():
+        need(Path(name).name==name,'file path')
+        b=read(name);eq(meta,{'bytes':len(b),'sha256':sha(b)},'file binding:'+name)
+    need(set(row['files'])=={'create.stdout','create.stderr','image-1.png','image-2.png','image-3.png','stream.jsonl',
+          'initial.stdout','initial.stderr','initialize.stdout','initialize.stderr','store.db',
+          'before.stdout','before.stderr','before.db','first.cursor.json','first.stdout','first.stderr',
+          'retain_first.stdout','retain_first.stderr','after_first.stdout','after_first.stderr','after_first.db',
+          'recovery.cursor.json','recovery.stdout','recovery.stderr','retain_recovery.stdout','retain_recovery.stderr',
+          'after_recovery.stdout','after_recovery.stderr','after_recovery.db','tail.cursor.json','tail.stdout','tail.stderr',
+          'processes.partial.json'},'artifact denominator')
+    calls=row['calls'];names=['create','initial','initialize','before','first','retain_first','after_first',
+                             'recovery','retain_recovery','after_recovery','tail']
+    eq([c['name'] for c in calls],names,'process order')
+    eq(json.loads(read('processes.partial.json')),calls,'process journal')
+    for c in calls:
+        n=c['name'];out=read(n+'.stdout');err=read(n+'.stderr')
+        eq(c['timeout'],False,'child timeout');eq(err.decode(),'', 'child stderr')
+        eq(c['returncode'],2 if n=='retain_first' and condition!='ROOM' else 0,'child wait status')
+        eq(c['stdout_sha256'],sha(out),'stdout binding');eq(c['stderr_sha256'],sha(err),'stderr binding')
+        need(type(c['pid']) is int and c['pid']>0,'child PID')
+        need(type(c['started_ns']) is int and type(c['finished_ns']) is int and c['finished_ns']>=c['started_ns'],'clock ordering')
+        need(out.endswith(b'\n'),'stdout framing')
+        obj=json.loads(out)
+        if n not in ('initial','first','recovery','tail'):eq(obj['pid'],c['pid'],'PID stdout binding')
+        if n in ('create','initialize','retain_first','retain_recovery'):
+            for k,v in [('authority','none'),('acknowledged',False),('input_dispatched',False)]:eq(obj[k],v,'worker authority')
+    need(len(set(c['pid'] for c in calls))==len(calls),'fresh process identities')
+    for a,b in zip(calls,calls[1:]):need(a['finished_ns']<=b['started_ns'],'phase ordering')
+    stream=read('stream.jsonl');need(stream.endswith(b'\n'),'stream framing')
+    lines=stream.splitlines(keepends=True);eq(len(lines),3,'stream denominator')
+    records=[json.loads(x) for x in lines];images={}
+    for seq,(w,h) in enumerate(((16,16),(128,64),(128,128)),1):
+        blob=read(f'image-{seq}.png');images[sha(blob)]=blob
+        need(len(blob)<=65536,'image bound')
+        png_check(blob,w,h,f'{phase}:r{rep}:{seq}')
+        eq(records[seq-1],{'event':'observation','sequence':seq,'image':f'image-{seq}.png',
+                           'image_sha256':sha(blob),'fixture_epoch':case,'delivery_id':f'delivery:{seq}'},'original ledger record')
+    c1=cursor(stream,1,case);c3=cursor(stream,3,case)
+    response_check(json.loads(read('initial.stdout')),records[:1],c1,'limit')
+    response_check(json.loads(read('first.stdout')),records[1:],c3,'end')
+    eq(json.loads(read('first.cursor.json')),c1,'first start cursor')
+    before=db_state(read('before.db'));mid=db_state(read('after_first.db'));end=db_state(read('after_recovery.db'))
+    d1=records[0]['image_sha256'];d2=records[1]['image_sha256'];d3=records[2]['image_sha256']
+    success=condition=='ROOM';atomic=policy=='ATOMIC_PAGE'
+    consumed_mid=1 if atomic and not success else 3
+    image_ids_mid=[d1,d2,d3] if success else [d1,d2] if not atomic and condition=='FULL_SECOND' else [d1]
+    image_ids_end=[d1,d2,d3] if success or atomic else image_ids_mid
+    for label,state,num,image_ids in [('before',before,1,[d1]),('after_first',mid,consumed_mid,image_ids_mid),
+                                      ('after_recovery',end,3,image_ids_end)]:
+        eq(state['cursor'],c1 if num==1 else c3,'database cursor:'+label)
+        eq(state['notifications'],[(i+1,records[i],records[i]['image_sha256']) for i in range(num)],'database notifications:'+label)
+        need(set(state['images'])==set(image_ids),'database image set:'+label)
+        for digest,blob in state['images'].items():need(blob==images[digest],'exact retained bytes:'+label)
+        eq([n for n,_ in state['pages']],[1] if num==1 else [1,3],'retained page identities')
+        need(state['pages'][0][1]==read('initial.stdout'),'old response bytes unchanged')
+        if num==3:need(state['pages'][1][1]==read('first.stdout'),'new response bytes unchanged')
+        eq(state['page_size'],4096,'page size');need(state['page_count']<=64,'bounded database size')
+        witness=json.loads(read(label+'.stdout'))
+        eq(witness['db_sha256'],sha(read(label+'.db')),'observer-to-DB binding')
+        eq(witness['cursor'],state['cursor'],'observer cursor')
+        eq(witness['notifications'],[x[1] for x in state['notifications']],'observer notifications')
+        eq(witness['images'],[{'sha':k,'bytes':len(state['images'][k]),'actual_sha256':sha(state['images'][k])} for k in sorted(state['images'])],'observer images')
+        eq(witness['pages'],[{'last_sequence':n,'response':json.loads(b),'response_sha256':sha(b)} for n,b in state['pages']],'observer pages')
+        eq(witness['integrity'],'ok','observer integrity');eq(witness['page_count'],state['page_count'],'observer page count')
+    need(read('store.db')==read('after_recovery.db'),'final DB bytes')
+    eq(json.loads(read('recovery.cursor.json')),mid['cursor'],'recovery start binding')
+    response_check(json.loads(read('recovery.stdout')),records[consumed_mid:],c3,'end')
+    response_check(json.loads(read('tail.stdout')),[],c3,'end')
+    eq(json.loads(read('tail.cursor.json')),end['cursor'],'tail cursor')
+    first=json.loads(read('retain_first.stdout'));rec=json.loads(read('retain_recovery.stdout'))
+    eq(first['status'],'RETAINED' if success else 'STORAGE_CAPACITY','first disposition')
+    eq(rec['status'],'RETAINED' if consumed_mid==1 else 'NO_PENDING','recovery disposition')
+    eq(row['first_status'],first['status'],'summary first');eq(row['recovery_status'],rec['status'],'summary recovery')
+    initial_count=before['page_count'];cfg=first['steps'][0]
+    eq(cfg['max_page_count'],64 if success else initial_count+(10 if condition=='FULL_SECOND' else 0),'quota')
+    eq([cfg['page_size'],cfg['journal_mode'],cfg['synchronous']],[4096,'delete',2],'SQLite config')
+    eq(rec['steps'][0]['max_page_count'],64,'explicit recovery quota')
+    attempted=[s['image_number'] for s in first['steps'] if s['operation']=='image_attempt']
+    eq(attempted,[1] if condition=='FULL_FIRST' else [1,2],'fault position')
+    image_staged=[s['image_number'] for s in first['steps'] if s['operation']=='image_staged']
+    eq(image_staged,[1,2] if success else [1] if condition=='FULL_SECOND' else [],'staged image denominator')
+    ops=[s['operation'] for s in first['steps']]
+    eq('metadata_committed' in ops,not atomic,'metadata commit policy')
+    eq('page_committed' in ops,atomic and success,'atomic commit marker')
+    if success:need(first['error'] is None,'positive storage error')
+    else:
+        eq(first['error']['code'],13,'native SQLITE_FULL code');eq(first['error']['name'],'SQLITE_FULL','native SQLITE_FULL name')
+        eq(first['steps'][-1]['in_transaction'],False,'rollback terminal state')
+    missing=[n for n,r,digest in end['notifications'] if digest not in end['images']]
+    return {'case_id':case,'policy':policy,'condition':condition,'first_status':first['status'],
+            'cursor_preserved_on_fault':not success and mid['cursor']==before['cursor'],
+            'recovery_new_records':3-consumed_mid,'missing_final_image_sequences':missing,
+            'all_images_retained':len(end['images'])==3,'processes':len(calls)}
+
+
+def inspect_rows(rows,phase,reps,read_for):
+    expected=[]
+    for rep in reps:
+        policies=('META_THEN_OBJECTS','ATOMIC_PAGE') if rep%2 else ('ATOMIC_PAGE','META_THEN_OBJECTS')
+        expected.extend((rep,c,p) for c in ('ROOM','FULL_FIRST','FULL_SECOND') for p in policies)
+    eq(len(rows),len(expected),'case denominator')
+    results=[]
+    for row,(rep,condition,policy) in zip(rows,expected):
+        eq([row['phase'],row['rep'],row['condition'],row['policy']],[phase,rep,condition,policy],'schedule')
+        results.append(check_case(row,lambda name,r=row:read_for(r,name)))
+    totals={}
+    for policy in ('META_THEN_OBJECTS','ATOMIC_PAGE'):
+        selected=[r for r in results if r['policy']==policy]
+        totals[policy]={'cases':len(selected),'capacity_failures':sum(r['first_status']=='STORAGE_CAPACITY' for r in selected),
+                        'safe_deferred':sum(r['cursor_preserved_on_fault'] for r in selected),
+                        'missing_image_cases':sum(bool(r['missing_final_image_sequences']) for r in selected),
+                        'missing_images':sum(len(r['missing_final_image_sequences']) for r in selected),
+                        'complete_after_recovery':sum(r['all_images_retained'] for r in selected)}
+    return {'audit':'PASS','disposition':'PASS_IMAGE_CAPACITY_TRANSACTION_SCOPED' if phase=='formal' else 'PASS_CONSTRUCTION_ONLY',
+            'errors':[],'cases':len(results),'processes':sum(r['processes'] for r in results),'totals':totals,'rows':results}
+
+
+def main(root,phase,reps):
+    if phase=='formal':
+        freeze=json.loads((root/'FREEZE.json').read_bytes())
+        for name,digest in freeze['sha256'].items():need(sha((root/name).read_bytes())==digest,'source freeze:'+name)
+    rows=[]
+    for rep in reps:
+        d=root/'evidence'/f'{phase}-r{rep}';raw=(d/'RAW.jsonl').read_bytes()
+        need(raw.endswith(b'\n'),'batch framing')
+        terminal=json.loads((d/'runner.stdout').read_bytes());execution=json.loads((d/'EXECUTION.json').read_bytes())
+        eq(terminal,{'status':'COMPLETED_UNSCORED','cases':6,'phase':phase,'rep':rep,'raw_sha256':sha(raw)},'batch terminal')
+        eq(execution['returncode'],0,'runner wait status');eq(execution['timeout'],False,'runner timeout')
+        need((d/'SUPERVISOR_EXIT.txt').read_bytes()==b'0\n','observed supervisor exit')
+        for channel in ('stdout','stderr'):eq(execution[channel+'_sha256'],sha((d/('runner.'+channel)).read_bytes()),'supervisor log hash')
+        need((d/'runner.stderr').read_bytes()==b'','runner stderr')
+        rows.extend(json.loads(line) for line in raw.splitlines())
+    return inspect_rows(rows,phase,reps,lambda row,name:(root/'evidence'/f"{phase}-r{row['rep']}"/row['case_id']/name).read_bytes())
+
+
+if __name__=='__main__':
+    try:
+        result=main(Path(sys.argv[1]),sys.argv[2],list(map(int,sys.argv[3:])))
+        print(json.dumps(result,sort_keys=True,indent=2))
+    except (ValueError,OSError,KeyError,TypeError,IndexError,sqlite3.DatabaseError,zlib.error,struct.error) as error:
+        print(json.dumps({'audit':'HOLD_OR_FAIL','errors':[str(error)]}));raise SystemExit(2)
