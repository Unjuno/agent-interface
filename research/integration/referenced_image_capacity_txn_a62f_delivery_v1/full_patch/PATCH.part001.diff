@@ -0,0 +1,186 @@
+"""Private storage fixture: no model, GUI, network, or action authority."""
+from __future__ import annotations
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import struct
+import sys
+import zlib
+
+ROOT = Path(__file__).resolve().parent
+LIMIT = 65536
+
+
+def enc(x):
+    return (json.dumps(x, sort_keys=True, allow_nan=False) + '\n').encode()
+
+
+def sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def image(width, height, salt):
+    # Ordinary synthetic RGB PNG, filter 0, lossless zlib compression.
+    raw = bytearray()
+    for y in range(height):
+        row = bytearray()
+        block = 0
+        while len(row) < width * 3:
+            row.extend(hashlib.sha256(f'{salt}:{y}:{block}'.encode()).digest())
+            block += 1
+        raw.extend(b'\0' + row[:width * 3])
+    def chunk(kind, data):
+        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))
+    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
+            + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))
+
+
+def create(d):
+    sys.path.insert(0, str(ROOT / 'upstream'))
+    from research.live_control.delivery_ledger_v2 import DeliveryLedger
+    ledger = DeliveryLedger()
+    records = []
+    for seq, size in enumerate(((16, 16), (128, 64), (128, 128)), 1):
+        b = image(*size, d.name + ':' + str(seq))
+        if len(b) > LIMIT:
+            raise ValueError('IMAGE_FIXTURE_BOUND')
+        name = f'image-{seq}.png'
+        (d / name).write_bytes(b)
+        records.append(ledger.prepare({'event': 'observation', 'sequence': seq, 'image': name,
+                                       'image_sha256': sha(b), 'fixture_epoch': d.name}))
+    (d / 'stream.jsonl').write_bytes(b''.join(enc(r) for r in records))
+    return {'status': 'CREATED', 'record_count': 3, 'image_sizes': [len((d / r['image']).read_bytes()) for r in records]}
+
+
+def connect(d):
+    c = sqlite3.connect(d / 'store.db', isolation_level=None, timeout=1)
+    c.execute('PRAGMA journal_mode=DELETE')
+    c.execute('PRAGMA synchronous=FULL')
+    c.execute('PRAGMA foreign_keys=ON')
+    return c
+
+
+def validate(d, response):
+    if (response['authority'] != 'none' or response['acknowledged'] is not False
+            or response['input_dispatched'] is not False or response['problem'] is not None):
+        raise ValueError('INVALID_READER_RESPONSE')
+    captured = []
+    for r in response['records']:
+        if r['fixture_epoch'] != d.name or r['event'] != 'observation':
+            raise ValueError('WRONG_EPOCH_OR_EVENT')
+        p = Path(r['image'])
+        if len(p.parts) != 1 or p.name not in ('image-1.png', 'image-2.png', 'image-3.png'):
+            raise ValueError('OUTSIDE_FIXTURE_IMAGE')
+        with (d / p).open('rb') as f:
+            b = f.read(LIMIT + 1)
+        if len(b) > LIMIT or sha(b) != r['image_sha256']:
+            raise ValueError('IMAGE_IDENTITY_MISMATCH')
+        captured.append((r['image_sha256'], b))
+    return captured
+
+
+def metadata(c, response, raw):
+    for r in response['records']:
+        c.execute('INSERT INTO notifications VALUES (?,?,?)', (r['sequence'], enc(r), r['image_sha256']))
+    c.execute('INSERT INTO pages VALUES (?,?)', (response['records'][-1]['sequence'], raw))
+    c.execute('UPDATE cursor SET payload=? WHERE id=1', (enc(response['next_cursor']),))
+
+
+def initialize(d):
+    raw = (d / 'initial.stdout').read_bytes()
+    response = json.loads(raw)
+    captured = validate(d, response)
+    if len(captured) != 1 or (d / 'store.db').exists():
+        raise ValueError('INVALID_INITIAL_STATE')
+    c = connect(d)
+    try:
+        c.executescript('''PRAGMA page_size=4096;
+        CREATE TABLE cursor(id INTEGER PRIMARY KEY CHECK(id=1), payload BLOB NOT NULL);
+        CREATE TABLE notifications(seq INTEGER PRIMARY KEY, body BLOB NOT NULL, image_sha TEXT NOT NULL);
+        CREATE TABLE pages(last_sequence INTEGER PRIMARY KEY, response BLOB NOT NULL);
+        CREATE TABLE images(sha TEXT PRIMARY KEY, data BLOB NOT NULL);
+        ''')
+        c.execute('BEGIN IMMEDIATE')
+        c.execute('INSERT INTO cursor VALUES (1, ?)', (b'{}',))
+        metadata(c, response, raw)
+        c.executemany('INSERT INTO images VALUES (?,?)', captured)
+        c.execute('COMMIT')
+        return {'status': 'INITIALIZED', 'page_count': c.execute('PRAGMA page_count').fetchone()[0]}
+    finally:
+        c.close()
+
+
+def retain(d, policy, condition, phase):
+    raw = (d / f'{phase}.stdout').read_bytes()
+    response = json.loads(raw)
+    start = json.loads((d / f'{phase}.cursor.json').read_bytes())
+    captured = validate(d, response)
+    c = connect(d)
+    steps = []
+    def mark(operation, **extra):
+        steps.append({'operation': operation, 'in_transaction': c.in_transaction,
+                      'page_count': c.execute('PRAGMA page_count').fetchone()[0], **extra})
+    def begin():
+        c.execute('BEGIN IMMEDIATE')
+        if json.loads(c.execute('SELECT payload FROM cursor WHERE id=1').fetchone()[0]) != start:
+            raise ValueError('START_CURSOR_CHANGED')
+    try:
+        pages = c.execute('PRAGMA page_count').fetchone()[0]
+        ceiling = 64 if phase == 'recovery' or condition == 'ROOM' else pages + (10 if condition == 'FULL_SECOND' else 0)
+        actual = c.execute(f'PRAGMA max_page_count={ceiling}').fetchone()[0]
+        if actual != ceiling:
+            raise ValueError('CAPACITY_CONFIG_MISMATCH')
+        mark('configured', max_page_count=actual, page_size=c.execute('PRAGMA page_size').fetchone()[0],
+             journal_mode=c.execute('PRAGMA journal_mode').fetchone()[0], synchronous=c.execute('PRAGMA synchronous').fetchone()[0])
+        if not response['records']:
+            return {'status': 'NO_PENDING', 'steps': steps, 'error': None}
+        if len(response['records']) != 2 or policy not in ('META_THEN_OBJECTS', 'ATOMIC_PAGE'):
+            raise ValueError('UNEXPECTED_PAGE_OR_POLICY')
+        begin()
+        metadata(c, response, raw)
+        mark('metadata_staged')
+        if policy == 'META_THEN_OBJECTS':
+            c.execute('COMMIT')
+            mark('metadata_committed')
+        for number, (digest, blob) in enumerate(captured, 1):
+            if policy == 'META_THEN_OBJECTS':
+                c.execute('BEGIN IMMEDIATE')
+            mark('image_attempt', image_number=number, image_sha256=digest, image_bytes=len(blob))
+            c.execute('INSERT INTO images VALUES (?,?)', (digest, blob))
+            mark('image_staged', image_number=number)
+            if policy == 'META_THEN_OBJECTS':
+                c.execute('COMMIT')
+                mark('image_committed', image_number=number)
+        if policy == 'ATOMIC_PAGE':
+            c.execute('COMMIT')
+            mark('page_committed')
+        return {'status': 'RETAINED', 'steps': steps, 'error': None}
+    except sqlite3.DatabaseError as exc:
+        error = {'type': type(exc).__name__, 'code': getattr(exc, 'sqlite_errorcode', None),
+                 'name': getattr(exc, 'sqlite_errorname', None), 'message': str(exc),
+                 'in_transaction_at_error': c.in_transaction}
+        if c.in_transaction:
+            c.execute('ROLLBACK')
+        mark('error_handled')
+        return {'status': 'STORAGE_CAPACITY' if error['code'] == sqlite3.SQLITE_FULL else 'STOP_STORAGE',
+                'steps': steps, 'error': error}
+    finally:
+        c.close()
+
+
+def main():
+    operation, directory = sys.argv[1:3]
+    d = Path(directory)
+    if operation == 'create': result = create(d)
+    elif operation == 'initialize': result = initialize(d)
+    elif operation == 'retain': result = retain(d, *sys.argv[3:6])
+    else: raise ValueError('UNKNOWN_OPERATION')
+    result.update(pid=os.getpid(), authority='none', acknowledged=False, input_dispatched=False)
+    sys.stdout.buffer.write(enc(result))
+    return 2 if result['status'] == 'STORAGE_CAPACITY' else 3 if result['status'].startswith('STOP') else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
