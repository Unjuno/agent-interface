φυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυτφυ