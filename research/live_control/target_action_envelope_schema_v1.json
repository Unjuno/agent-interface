{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "target", "button", "duration_ms"],
  "properties": {
    "op": {"type": "string", "const": "pointer_click"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "target_handle", "dx", "dy"],
      "properties": {
        "kind": {"type": "string", "enum": ["absolute", "handle"]},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "target_handle": {"type": "string"},
        "dx": {"type": "integer"},
        "dy": {"type": "integer"}
      }
    },
    "button": {"type": "integer", "const": 1},
    "duration_ms": {"type": "integer", "const": 80}
  }
}
