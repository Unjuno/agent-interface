{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "receipt_index", "point_space", "points", "motion_model", "evidence_kind", "diagnostic_reason"],
  "properties": {
    "op": {"type": "string", "enum": ["target_reference", "needs_decision"]},
    "receipt_index": {"type": "integer", "minimum": 0, "maximum": 7},
    "point_space": {"type": "string", "enum": ["source_observation_pixels", "not_applicable"]},
    "points": {
      "type": "array", "minItems": 0, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["x", "y"],
        "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
      }
    },
    "motion_model": {"type": "string", "enum": ["surface_origin_translation", "not_applicable"]},
    "evidence_kind": {"type": "string", "enum": ["persistent_hover_tooltip"]},
    "diagnostic_reason": {"type": "string", "enum": ["matched", "no_match_in_observed_set", "ambiguous_evidence", "unavailable_evidence", "search_budget_exhausted"]}
  }
}
