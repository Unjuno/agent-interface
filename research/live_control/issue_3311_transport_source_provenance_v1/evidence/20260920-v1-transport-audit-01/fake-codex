#!/usr/bin/env python3
import json, os, sys
a=sys.argv
if a[1:] == ['--version']:
 print('codex fake-transport-v1'); raise SystemExit(0)
schema=a[a.index('--output-schema')+1]
work=a[a.index('-C')+1]
instructions=next(v.split('=',1)[1] for v in a if v.startswith('model_instructions_file='))
if not os.path.isfile(schema) or not os.path.isdir(work): raise SystemExit(81)
if not os.path.isfile(json.loads(instructions)): raise SystemExit(82)
print(json.dumps({'type':'thread.started','thread_id':'synthetic-v1'}))
print(json.dumps({'type':'item.completed','item':{'type':'agent_message','text':'{}'}}))
print(json.dumps({'type':'turn.completed','usage':{'input_tokens':1,'output_tokens':1}}))
