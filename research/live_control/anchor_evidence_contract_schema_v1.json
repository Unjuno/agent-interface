{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "receipt_index", "point_space", "point", "motion_model", "evidence_kind"],
  "properties": {
    "op": {"type": "string", "enum": ["target_reference", "expand_search"]},
    "receipt_index": {"type": "integer", "const": 1},
    "point_space": {"type": "string", "enum": ["source_observation_pixels"]},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
    },
    "motion_model": {"type": "string", "enum": ["surface_origin_translation"]},
    "evidence_kind": {"type": "string", "enum": ["persistent_hover_tooltip"]}
  }
}
