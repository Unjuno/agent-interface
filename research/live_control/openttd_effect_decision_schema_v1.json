{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "next_action", "memory_use"],
  "properties": {
    "format": {"type": "string", "const": "openttd-effect-decision-v1"},
    "status": {"type": "string", "enum": ["observed", "uncertain", "contradicted"]},
    "next_action": {"type": "string", "enum": ["advance_without_repeat", "inspect_without_mutation", "recover_without_repeat"]},
    "memory_use": {"type": "string", "enum": ["none", "supporting", "rejected_as_stale_or_misleading"]}
  }
}
