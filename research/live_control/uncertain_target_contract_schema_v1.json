{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "point_space", "point", "points", "motion_model", "confidence_basis"],
  "properties": {
    "op": {"type": "string", "enum": ["target_reference", "request_hover_probe"]},
    "point_space": {"type": "string", "enum": ["source_observation_pixels"]},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
    },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
      }
    },
    "motion_model": {"type": "string", "enum": ["surface_origin_translation", "not_applicable"]},
    "confidence_basis": {"type": "string", "enum": ["visually_unambiguous", "icons_ambiguous"]}
  }
}
