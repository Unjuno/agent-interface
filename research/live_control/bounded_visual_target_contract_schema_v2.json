{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["op", "point_space", "point", "motion_model", "confidence_basis"],
      "properties": {
        "op": {"const": "target_reference"},
        "point_space": {"const": "source_observation_pixels"},
        "point": {"type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}},
        "motion_model": {"const": "surface_origin_translation"},
        "confidence_basis": {"const": "visually_unambiguous"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["op", "point_space", "points", "motion_model", "confidence_basis"],
      "properties": {
        "op": {"const": "request_hover_probe"},
        "point_space": {"const": "source_observation_pixels"},
        "points": {"type": "array", "minItems": 1, "maxItems": 3,
          "items": {"type": "object", "additionalProperties": false, "required": ["x", "y"],
            "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}}},
        "motion_model": {"const": "surface_origin_translation"},
        "confidence_basis": {"const": "visual_probe_required"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["op", "reason"],
      "properties": {
        "op": {"const": "needs_decision"},
        "reason": {"type": "string", "enum": ["no_candidate", "ambiguous", "unreadable"]}
      }
    }
  ]
}
