diff --git a/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/oracle.py b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/oracle.py
new file mode 100644
index 0000000..52d96a4
--- /dev/null
+++ b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/oracle.py
@@ -0,0 +1,147 @@
+"""Independent stdlib-only reconstruction; never imports candidate or runner."""
+from pathlib import Path
+import argparse,copy,gzip,hashlib,json,statistics,struct,sys
+import zlib
+HERE=Path(__file__).resolve().parent
+PREFIX=struct.Struct('!4sI'); TILE=struct.Struct('!IIII')
+MED=statistics.median
+ARMS=('legacy','vector','profile')
+CHANGED=['metadata','frame_equal','full_header','full_compress','full_packet_join','views','dirty_mask','tile_copy','tile_payload_join','tiles_header','tiles_compress','tiles_packet_join','select_commit']
+UNCHANGED=['metadata','frame_equal','unchanged_header','unchanged_compress','unchanged_packet_join','select_commit']
+def req(ok,msg):
+    if not ok:raise ValueError(msg)
+def integer(v):return type(v) is int
+def sha(b):return hashlib.sha256(b).hexdigest()
+def packet(meta,payload):
+    head=json.dumps(meta,sort_keys=True,separators=(',',':')).encode()
+    return PREFIX.pack(b'AIT1',len(head))+head+zlib.compress(payload,1)
+def codec_oracle(root,spec):
+    p=root/'inputs'/spec['case'];old=json.loads((p/'case.json').read_text())
+    raw=[gzip.decompress((p/(n+'.rgb.gz')).read_bytes()) for n in ['before','after']]
+    w,h=spec['width'],spec['height'];req(spec['mode']=='RGB','mode')
+    for i,n in enumerate(['before','after']):
+        req(len(raw[i])==w*h*3 and sha(raw[i])==spec[n+'_sha256'],'pixel bytes')
+    def meta(seq,kind):
+        return dict(stream=spec['case'],sequence=seq,base=seq-1,width=w,height=h,mode='RGB',action_id=spec['case'],observed_ns=old['captures']['before' if seq==1 else 'after'][0]['end_ns'],context=['fixture'],kind=kind)
+    first=packet(meta(1,'full'),raw[0]);size_map={};count=0
+    if raw[0]==raw[1]:
+        wire=packet(meta(2,'unchanged'),b'');kind='unchanged';size_map={'unchanged':len(wire)}
+    else:
+        full=packet(meta(2,'full'),raw[1]);pieces=[]
+        for y in range(0,h,64):
+            th=min(64,h-y)
+            for x in range(0,w,64):
+                tw=min(64,w-x)
+                oldrows=[raw[0][((y+j)*w+x)*3:((y+j)*w+x+tw)*3] for j in range(th)]
+                newrows=[raw[1][((y+j)*w+x)*3:((y+j)*w+x+tw)*3] for j in range(th)]
+                if oldrows!=newrows:
+                    count+=1;pieces.extend([TILE.pack(x,y,tw,th),b''.join(newrows)])
+        tm=meta(2,'tiles');tm['count']=count;tile=packet(tm,b''.join(pieces))
+        wire,kind=(tile,'tiles') if len(tile)<len(full) else (full,'full')
+        size_map={'full':len(full),'tiles':len(tile)}
+    req(first==(p/'legacy-initial.ait').read_bytes(),'canonical initial')
+    req(wire==(p/'legacy-update.ait').read_bytes(),'canonical update')
+    return dict(initial_sha256=sha(first),wire_sha256=sha(wire),wire_bytes=len(wire),kind=kind,changed_tiles=count,packet_sizes=size_map)
+
+def check_sample(row,ordinal,spec,sc,expect):
+    req(integer(row['ordinal']) and row['ordinal']==ordinal,'ordinal')
+    req(row['phase']==('warmup' if ordinal<sc['warmup'] else 'timed'),'sample phase')
+    order=sc['orders'][(ordinal+spec['index'])%len(sc['orders'])]
+    req(row['order']==order and set(row['arms'])==set(ARMS),'arm order/cardinality')
+    prior_end=None
+    for arm in order:
+        d=row['arms'][arm]
+        for n in ['start_ns','end_ns','wall_ns','cpu_ns','wire_bytes','changed_tiles']:req(integer(d[n]),'typed '+n)
+        req(d['end_ns']>d['start_ns'] and d['wall_ns']==d['end_ns']-d['start_ns'] and d['cpu_ns']>0,'time identity')
+        if prior_end is not None:req(d['start_ns']>prior_end,'arm interval ordering')
+        prior_end=d['end_ns']
+        for n in ['initial_sha256','wire_sha256','wire_bytes','kind','changed_tiles']:req(d[n]==expect[n],'codec '+n)
+        if arm=='profile':
+            tr=d['trace'];expected_names=UNCHANGED if expect['kind']=='unchanged' else CHANGED
+            req([v[0] for v in tr]==expected_names,'phase denominator/order')
+            req(d['packet_sizes']==expect['packet_sizes'] and all(integer(v) for v in d['packet_sizes'].values()),'packet size decomposition')
+            req(d['start_ns']<=tr[0][1] and tr[-1][2]<=d['end_ns'],'trace envelope')
+            last=tr[0][1];duration=0
+            for name,start,end in tr:
+                req(integer(start) and integer(end) and start==last and end>=start,'trace continuity')
+                duration+=end-start;last=end
+            req(duration==tr[-1][2]-tr[0][1] and duration<=d['wall_ns'],'phase sum')
+
+def validate_records(root,sc,data):
+    req(list(data)==[s['case'] for s in sc['cases']],'case denominator/order')
+    metrics=[]
+    for spec in sc['cases']:
+        raw=data[spec['case']];req(raw['case']==spec['case'] and type(raw['index']) is int and raw['index']==spec['index'],'case identity')
+        req(len(raw['samples'])==sc['warmup']+sc['timed'],'sample denominator')
+        expect=codec_oracle(root,spec)
+        for ordinal,row in enumerate(raw['samples']):check_sample(row,ordinal,spec,sc,expect)
+        timed=raw['samples'][sc['warmup']:];comp=[];dirty=[];copycost=[];fullcost=[];packet_sizes=expect['packet_sizes']
+        phase_shares={n:[] for n in (UNCHANGED if expect['kind']=='unchanged' else CHANGED)}
+        for row in timed:
+            d=row['arms']['profile'];ph={n:b-a for n,a,b in d['trace']};total=d['wall_ns']
+            comp.append(sum(v for n,v in ph.items() if n.endswith('_compress'))/total)
+            dirty.append(ph.get('dirty_mask',0)/total);copycost.append((ph.get('tile_copy',0)+ph.get('tile_payload_join',0))/total)
+            fullcost.append(ph.get('full_compress',0)/total)
+            for n in ph:phase_shares[n].append(ph[n]/total)
+        obs=MED(r['arms']['profile']['wall_ns']/r['arms']['vector']['wall_ns'] for r in timed)
+        metrics.append({'case':spec['case'],'scene':spec['scene'],'width':spec['width'],'height':spec['height'],'kind':expect['kind'],'changed_tiles':expect['changed_tiles'],
+          'wall_median_ns':{a:MED(r['arms'][a]['wall_ns'] for r in timed) for a in ARMS},
+          'cpu_median_ns':{a:MED(r['arms'][a]['cpu_ns'] for r in timed) for a in ARMS},
+          'profile_vector_ratio_median':obs,'vector_legacy_ratio_median':MED(r['arms']['vector']['wall_ns']/r['arms']['legacy']['wall_ns'] for r in timed),
+          'profile_vector_ratio_range':[min(r['arms']['profile']['wall_ns']/r['arms']['vector']['wall_ns'] for r in timed),max(r['arms']['profile']['wall_ns']/r['arms']['vector']['wall_ns'] for r in timed)],
+          'compression_fraction_median':MED(comp),'dirty_fraction_median':MED(dirty),'copy_join_fraction_median':MED(copycost),'full_compression_fraction_median':MED(fullcost),
+          'phase_fraction_medians':{n:MED(vals) for n,vals in phase_shares.items()},'full_compression_discarded':expect['kind']=='tiles','packet_sizes':packet_sizes,
+          'observer_gate':sc['observer_ratio_low']<=obs<=sc['observer_ratio_high']})
+    changed=[m for m in metrics if m['scene']!='unchanged']
+    req(len(changed)==12,'changed cases')
+    observed=all(m['observer_gate'] for m in changed)
+    dominant=MED(m['compression_fraction_median'] for m in changed)>=sc['compression_fraction_gate']
+    decision='HOLD_INSTRUMENTATION_PERTURBATION' if not observed else ('PASS_COMPRESSION_DOMINANT_SCOPED' if dominant else 'HOLD_COMPRESSION_DOMINANCE_NOT_ESTABLISHED')
+    return {'status':decision,'integrity':'PASS_RAW_RECONSTRUCTION','errors':[], 'cases':len(data),'timed_triples':len(data)*sc['timed'],'warmup_triples':len(data)*sc['warmup'],
+            'observer_gate_pass_cases':sum(m['observer_gate'] for m in changed),'changed_compression_median':MED(m['compression_fraction_median'] for m in changed),
+            'full_compression_discarded_changed_cases':sum(m['full_compression_discarded'] for m in changed),'case_metrics':metrics}
+
+def verify_root(root):
+    freeze=json.loads((root/'FREEZE.json').read_text()); sc=json.loads((root/'schedule.json').read_text());data={};receipts=[]
+    for n,h in freeze['files'].items():req(sha((root/n).read_bytes())==h,'frozen '+n)
+    for batch,(lo,hi) in enumerate(sc['batches']):
+        out=root/'formal'/('batch-%d'%batch);r=json.loads((out/'EXECUTION.json').read_text());end=json.loads((out/'END.json').read_text());start=json.loads((out/'start.json').read_text())
+        req(integer(r['returncode']) and r['returncode']==0 and r['timed_out'] is False,'external exit')
+        req(r['freeze_sha256']==sha((root/'FREEZE.json').read_bytes())==start['freeze_sha256'],'source binding')
+        req(start['batch']==batch and start['affinity']==[1] and integer(start['pid']),'batch env')
+        req(r['end_sha256']==sha((out/'END.json').read_bytes()),'terminal hash')
+        req(r['stdout_sha256']==sha((out/'stdout.txt').read_bytes()) and r['stderr_sha256']==sha((out/'stderr.txt').read_bytes()),'stdout binding')
+        req((out/'stderr.txt').read_bytes()==b'','stderr empty')
+        req(end['batch']==batch and integer(end['cases']) and end['cases']==5 and end['status']=='COMPLETED','terminal denominator')
+        req([m['case'] for m in end['case_manifest']]==[s['case'] for s in sc['cases'][lo:hi]],'terminal case sequence')
+        for m in end['case_manifest']:
+            p=out/(m['case']+'.json');req(sha(p.read_bytes())==m['sha256'],'raw hash');data[m['case']]=json.loads(p.read_text())
+        receipts.append(r)
+    result=validate_records(root,sc,data);result['raw_sha256']={cid:sha(json.dumps(v,sort_keys=True,separators=(',',':')).encode()) for cid,v in data.items()}
+    result['external_exits']=[r['returncode'] for r in receipts]
+    return result,sc,data
+
+def corruption_controls(root,sc,data):
+    ids=list(data); controls={}
+    for name in ['missing_case','duplicate_sample','wrong_order','bool_count','wire_identity','negative_phase','missing_phase','wrong_packet_size']:
+        d=copy.deepcopy(data); key=ids[1];row=d[key]['samples'][3]
+        if name=='missing_case':del d[ids[-1]]
+        elif name=='duplicate_sample':d[key]['samples'][4]=copy.deepcopy(row)
+        elif name=='wrong_order':row['order']=list(reversed(row['order']))
+        elif name=='bool_count':row['arms']['vector']['changed_tiles']=True
+        elif name=='wire_identity':row['arms']['legacy']['wire_sha256']='0'*64
+        elif name=='negative_phase':row['arms']['profile']['trace'][3][2]=row['arms']['profile']['trace'][3][1]-1
+        elif name=='missing_phase':row['arms']['profile']['trace'].pop(3)
+        elif name=='wrong_packet_size':row['arms']['profile']['packet_sizes']['full']+=1
+        try:validate_records(root,sc,d)
+        except (ValueError,KeyError,TypeError,IndexError) as e:controls[name]={'rejected':True,'reason':str(e)}
+        else:controls[name]={'rejected':False}
+    req(all(v['rejected'] for v in controls.values()),'corruption accepted')
+    return controls
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--root',type=Path,default=HERE);ap.add_argument('--controls',action='store_true');a=ap.parse_args()
+    result,sc,data=verify_root(a.root)
+    if a.controls:result['corruption_controls']=corruption_controls(a.root,sc,data)
+    print(json.dumps(result,indent=2,sort_keys=True));return 0
+if __name__=='__main__':raise SystemExit(main())
diff --git a/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/run_batch.py b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/run_batch.py
new file mode 100644
index 0000000..eb23413
--- /dev/null
+++ b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/run_batch.py
@@ -0,0 +1,62 @@
+"""One bounded first-outcome CPU batch; historical capture metadata is opaque."""
+from pathlib import Path
+import argparse,gzip,hashlib,json,os,sys,time,traceback
+from candidate import Frame,VectorEncoder,reference
+from contiguous import ContiguousEncoder
+HERE=Path(__file__).resolve().parent
+CLASSES={'legacy':reference.Encoder,'vector':VectorEncoder,'contiguous':ContiguousEncoder}
+def sha(b):return hashlib.sha256(b).hexdigest()
+def dump(p,obj):p.write_text(json.dumps(obj,sort_keys=True,indent=2)+'\n')
+def verify_freeze():
+    f=json.loads((HERE/'FREEZE.json').read_text())
+    for n,h in f['files'].items():
+        if sha((HERE/n).read_bytes())!=h:raise ValueError('source/input mismatch: '+n)
+    return f
+
+def one_case(spec,schedule,out):
+    folder=HERE/'inputs'/spec['case']; old=json.loads((folder/'case.json').read_text())
+    frames=[Frame(spec['width'],spec['height'],'RGB',gzip.decompress((folder/(p+'.rgb.gz')).read_bytes())) for p in ['before','after']]
+    expected=[(folder/('legacy-'+p+'.ait')).read_bytes() for p in ['initial','update']]
+    kwargs=[dict(action_id=spec['case'],observed_ns=old['captures'][p][0]['end_ns'],context=('fixture',)) for p in ['before','after']]
+    rows=[]
+    for ordinal in range(schedule['warmup']+schedule['timed']):
+        order=schedule['orders'][(ordinal+spec['index'])%len(schedule['orders'])]
+        row={'ordinal':ordinal,'phase':'warmup' if ordinal<schedule['warmup'] else 'timed','order':order,'arms':{}}
+        for arm in order:
+            enc=CLASSES[arm](spec['case']); initial=enc.encode(frames[0],**kwargs[0])
+            cpu0=time.process_time_ns();start=time.perf_counter_ns()
+            wire=enc.encode(frames[1],**kwargs[1])
+            end=time.perf_counter_ns();cpu1=time.process_time_ns()
+            if (initial,wire)!=tuple(expected):raise ValueError('wire equality: '+arm)
+            dec=reference.Decoder(spec['case'])
+            if dec.accept(initial)!=frames[0] or dec.accept(wire)!=frames[1]:raise ValueError('decoder mismatch')
+            d={'start_ns':start,'end_ns':end,'wall_ns':end-start,'cpu_ns':cpu1-cpu0,
+               'initial_sha256':sha(initial),'wire_sha256':sha(wire),'wire_bytes':len(wire),
+               'kind':enc.last['kind'],'changed_tiles':enc.last['changed_tiles']}
+            row['arms'][arm]=d
+        rows.append(row)
+    result={'case':spec['case'],'index':spec['index'],'samples':rows}
+    dump(out/(spec['case']+'.json'),result)
+    return {'case':spec['case'],'sha256':sha((out/(spec['case']+'.json')).read_bytes())}
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--batch',type=int,required=True);ap.add_argument('--out',type=Path,required=True);a=ap.parse_args()
+    f=verify_freeze();sc=json.loads((HERE/'schedule.json').read_text()); assert a.batch in range(3)
+    out=a.out.resolve();assert out==HERE/'formal'/('batch-%d'%a.batch)
+    active=json.loads((HERE/'ENVIRONMENT.json').read_text())
+    import zlib
+    if (sys.version!=active['python'] or reference.np.__version__!=active['numpy'] or
+            zlib.ZLIB_RUNTIME_VERSION!=active['zlib_runtime'] or
+            sha(Path(sys.executable).read_bytes())!=active['python_sha256']):
+        raise ValueError('active environment mismatch')
+    os.sched_setaffinity(0,{1});manifest=[]
+    dump(out/'start.json',{'batch':a.batch,'pid':os.getpid(),'affinity':sorted(os.sched_getaffinity(0)),'freeze_sha256':sha((HERE/'FREEZE.json').read_bytes()),'python':sys.version})
+    try:
+        lo,hi=sc['batches'][a.batch]
+        for spec in sc['cases'][lo:hi]:
+            manifest.append(one_case(spec,sc,out));dump(out/'progress.json',manifest)
+        verify_freeze();dump(out/'END.json',{'batch':a.batch,'case_manifest':manifest,'cases':len(manifest),'status':'COMPLETED'})
+        print(json.dumps({'batch':a.batch,'cases':len(manifest),'status':'COMPLETED'}));return 0
+    except Exception:
+        dump(out/'STOP.json',{'completed_cases':len(manifest),'traceback':traceback.format_exc()});traceback.print_exc();return 2
+if __name__=='__main__':raise SystemExit(main())
