{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["assessment", "state", "commands"],
  "properties": {
    "assessment": {"type": "string", "maxLength": 180},
    "state": {"enum": ["active", "dead", "exit_or_transition"]},
    "commands": {"type": "array", "minItems": 0, "maxItems": 5,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["action", "extent"],
        "properties": {
          "action": {"enum": ["turn_left", "turn_right", "forward", "backward", "strafe_left", "strafe_right", "use", "fire", "advance_fire", "retreat_fire"]},
          "extent": {"enum": ["pulse", "short", "medium", "long"]}
        }
      }
    }
  }
}
