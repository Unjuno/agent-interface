{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment", "steps"],
  "properties": {
    "assessment": {"type": "string", "maxLength": 160},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keys", "duration_ms"],
        "properties": {
          "keys": {"type": "array", "minItems": 1, "maxItems": 4,
            "items": {"enum": ["Left", "Right", "Up", "Down", "a", "d", "e", "Return", "space", "Shift_L"]}},
          "duration_ms": {"type": "integer", "minimum": 50, "maximum": 2500}
        }
      }
    }
  }
}
