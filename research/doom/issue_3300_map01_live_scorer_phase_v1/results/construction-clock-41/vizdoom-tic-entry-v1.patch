+#include <time.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdint.h>
+
+/* Excluded construction instrumentation: timestamp VIZ_Tic before debug logging. */
+struct VIZ_TicEntryRecord {
+    uint64_t pid;
+    uint64_t monotonic_ns;
+    int32_t gametic;
+    int32_t viz_time;
+};
+
+static void VIZ_RecordTicEntry(){
+    struct timespec ts;
+    if(clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return;
+    static int fd = -2;
+    if(fd == -2) fd = open("/tmp/vizdoom-tic-entry-v1.bin", O_WRONLY | O_CREAT | O_APPEND, 0600);
+    if(fd < 0) return;
+    struct VIZ_TicEntryRecord record = {
+        (uint64_t)getpid(),
+        (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec,
+        (int32_t)gametic,
+        (int32_t)vizTime
+    };
+    (void)write(fd, &record, sizeof(record));
+}
+
 void VIZ_Tic(){
+    VIZ_RecordTicEntry();
 
     VIZ_DebugMsg(2, VIZ_FUNC, "tic: %d, vizTime: %d", gametic, vizTime);
     VIZ_DebugMsg(4, VIZ_FUNC, "rngseed: %d, use_staticrng: %d, staticrngseed: %d", rngseed, use_staticrng, staticrngseed);
