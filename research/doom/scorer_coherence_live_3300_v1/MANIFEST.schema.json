{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_sha256", "image", "network", "raw_sha256", "controls"],
  "properties": {
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {"type": "object", "required": ["reference", "digest"], "properties": {
      "reference": {"type": "string"},
      "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }},
    "network": {"const": "none"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controls": {"type": "array", "minItems": 3, "items": {
      "enum": ["nominal", "delayed_observation", "stale_epoch"]
    }}
  }
}
