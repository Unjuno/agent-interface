{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Unjuno/agent-interface/blob/main/research/orchestration/o2_g1/w2_measurement_v2_20260927/event-schema.json",
  "title": "Useful-control trace envelope v2",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "clock_domains",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "useful-control-trace-v2"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "clock_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clockDomain"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "clockDomain": {
      "type": "object",
      "required": [
        "domain_id",
        "epoch_id",
        "kind",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "monotonic",
            "calibrated_monotonic"
          ]
        },
        "unit": {
          "const": "ns"
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "lower_ns",
        "upper_ns",
        "censoring"
      ],
      "additionalProperties": false,
      "properties": {
        "lower_ns": {
          "type": "integer",
          "minimum": 0
        },
        "upper_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "censoring": {
          "enum": [
            "exact",
            "bounded",
            "left",
            "right",
            "unknown"
          ]
        }
      }
    },
    "clockRef": {
      "type": "object",
      "required": [
        "domain_id",
        "epoch_id"
      ],
      "additionalProperties": false,
      "properties": {
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "program_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actuation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "lease_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capture_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "source_role",
        "clock",
        "time",
        "input_authority",
        "semantic_authority",
        "lineage",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "MODEL_WAIT_OPEN",
            "MODEL_WAIT_CLOSE",
            "PROGRAM_ACCEPTED",
            "PROGRAM_TERMINAL",
            "POLICY_CURRENT",
            "LEASE_OPEN",
            "LEASE_CLOSE",
            "INPUT_EDGE_BRACKET",
            "SERVER_STATE_SAMPLE",
            "OBSERVED_CHANGE",
            "RESOURCE_CHANGE",
            "TASK_EFFECT",
            "FEEDBACK_DELIVERED",
            "CANCEL_REQUEST",
            "REVOKE",
            "SCORE_SAMPLE"
          ]
        },
        "source_role": {
          "enum": [
            "controller",
            "executor",
            "backend",
            "server_observer",
            "application_observer",
            "independent_scorer",
            "model"
          ]
        },
        "clock": {
          "$ref": "#/$defs/clockRef"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "input_authority": {
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "semantic_authority": {
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
