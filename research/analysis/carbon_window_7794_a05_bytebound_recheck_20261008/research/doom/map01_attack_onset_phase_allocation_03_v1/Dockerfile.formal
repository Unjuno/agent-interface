FROM --platform=linux/amd64 python:3.13.5-slim-bookworm@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PIP_NO_INDEX=1 DISPLAY=:99
RUN apt-get update -qq && apt-get install -y --no-install-recommends xvfb openbox libgl1 libglib2.0-0 libxext6 libxrender1 libsm6 && rm -rf /var/lib/apt/lists/*
COPY wheels /opt/wheels
RUN python -m pip install --no-index --no-deps --find-links=/opt/wheels \
    cloudpickle==3.1.2 et-xmlfile==2.0.0 farama-notifications==0.0.6 \
    gymnasium==1.3.0 numpy==2.5.3 openpyxl==3.1.5 pillow==12.3.0 \
    pygame-ce==2.5.8 python-xlib==0.33 six==1.17.0 \
    typing-extensions==4.16.0 vizdoom==1.3.0
ENTRYPOINT ["/bin/sh", "-c", "Xvfb :99 -screen 0 1280x800x24 -nolisten tcp -ac >/tmp/xvfb.log 2>&1 & openbox >/tmp/openbox.log 2>&1 & sleep 1; exec \"$@\"", "formal"]
