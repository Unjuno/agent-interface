FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglu1-mesa libsdl2-2.0-0 libopenal1 ca-certificates xvfb openbox xdotool x11-apps \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir vizdoom==1.3.0
WORKDIR /opt/phase-probe
COPY research/doom/session_map01_v13.py \
     research/doom/map01_scorer_stdio_adapter_v1.py \
     research/doom/main_thread_scorer_polling_v1.py \
     research/doom/independent_progress_clock_v2.py /opt/phase-probe/
COPY research/doom/issue_3300_map01_live_scorer_phase_v1/runner.py \
     research/doom/issue_3300_map01_live_scorer_phase_v1/schedule.json \
     research/doom/issue_3300_map01_live_scorer_phase_v1/audit.py \
     research/doom/issue_3300_map01_live_scorer_phase_v1/test_audit.py \
     research/doom/issue_3300_map01_live_scorer_phase_v1/Dockerfile.xvfb /opt/phase-probe/
ENTRYPOINT ["python", "runner.py"]
