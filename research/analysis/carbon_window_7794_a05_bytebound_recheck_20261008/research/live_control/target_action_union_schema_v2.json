{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "x", "y", "button", "duration_ms"],
      "properties": {
        "op": {"type": "string", "const": "pointer_click"},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "button": {"type": "integer", "const": 1},
        "duration_ms": {"type": "integer", "const": 80}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_handle", "offset", "button", "duration_ms"],
      "properties": {
        "op": {"type": "string", "const": "pointer_click_target"},
        "target_handle": {"type": "string", "const": "h_save_form"},
        "offset": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 2,
          "maxItems": 2
        },
        "button": {"type": "integer", "const": 1},
        "duration_ms": {"type": "integer", "const": 80}
      }
    }
  ]
}
