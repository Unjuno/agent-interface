{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "candidate_id", "point_space", "point", "motion_model"],
  "properties": {
    "op": {"type": "string", "const": "target_reference"},
    "candidate_id": {"type": "string", "enum": ["subsidies", "trains", "roads"]},
    "point_space": {"type": "string", "const": "source_observation_pixels"},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "motion_model": {
      "type": "string",
      "enum": ["surface_origin_translation", "screen_fixed"]
    }
  }
}
