"""Raw-only finite-corpus oracle; imports no candidate or measurement harness."""
import copy
import hashlib
import itertools
import json
import math
from pathlib import Path

POLICIES = ('FULL_V3', 'PACED_BRIEF', 'PUBLIC_SUMMARY')
CASES = ('entry', 'save', 'refusal')

def canonical(v):
    return json.dumps(v, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()

def same(left, right):
    try:
        return canonical(left) == canonical(right)
    except (ValueError, TypeError):
        return False

def digest(data):
    return hashlib.sha256(data).hexdigest()

def timing_errors(row, minimum):
    errors=[]
    if type(row.get('count')) is not int or row['count'] != 3:
        errors.append('count')
    for k in ('wall_ns','cpu_ns'):
        if type(row.get(k)) is not int or row[k] < minimum:
            errors.append(k + ':granularity_or_type')
    return errors

def expected_view(case, policy, source, expected):
    if policy == 'FULL_V3' or case == 'refusal' or (case == 'save' and policy == 'PACED_BRIEF'):
        return copy.deepcopy(source)
    if policy == 'PUBLIC_SUMMARY':
        return copy.deepcopy(expected)
    if case != 'entry' or policy != 'PACED_BRIEF':
        raise ValueError('unsupported oracle case')
    # Finite-corpus reconstruction from raw provenance, independently coded.
    v=copy.deepcopy(source)
    receipt=v['receipt']; original=source['receipt']['source']['raw_report']
    r=receipt['source'].pop('raw_report')
    receipt['source']['report_projection']=r
    omitted=[]
    for section in ('normalization','compilation'):
        data=canonical(original[section]['source_program'])
        r[section].pop('source_program')
        r[section]['source_program_omitted']={'sha256':digest(data),'encoding':'UTF-8 canonical JSON: sorted keys, compact separators, ensure_ascii=true','bytes':len(data)}
        omitted.append('/receipt/source/raw_report/'+section+'/source_program')
    waits=r['result']['execution'].pop('waits')
    mapping=r['compilation'].pop('operation_sources')
    def marker(value):
        data=canonical(value)
        return {'sha256':digest(data),'bytes':len(data),'encoding':'canonical JSON, UTF-8, sorted keys, compact, ensure_ascii=true'}
    r['result']['execution']['wait_summary']={'count':len(waits),'requested_ms_total':sum(w['requested_ms'] for w in waits),'recorded_elapsed_ns_total':sum(w['ended_ns']-w['started_ns'] for w in waits),'kind':'fixed_delay','update_observed':None,'all_completed':True,'omitted_records':marker(waits)}
    r['compilation']['operation_sources_omitted']={'count':len(mapping),**marker(mapping)}
    receipt.update(schema='agent-interface/receipt-view-paced-brief-v1',report={'report_ref':'/source/report_projection'},report_reference='/source/report_projection',reference_scope='Partial report projection only; original source digest identifies the retained full report.',scope='Partial retained report projection; full report requires explicit retrieval. No input or freshness granted.')
    v['presentation']={'requested':'brief','returned':'brief','scope':'Partial success-only projection: source programs, wait records and expansion map omitted. Not lossless or task success.','omitted_paths':omitted+['/receipt/source/raw_report/result/execution/waits','/receipt/source/raw_report/compilation/operation_sources'],'retrieve':{'tool':'interface_results','arguments':{'call_id':source['call_id'],'include_image':False,'compact':True,'report_refs':True,'detail':'full'}}}
    return v

def preserved_errors(source, projected):
    errors=[]
    for k in ('authority','call_id','call_directory','session','outcome_summary','image_reference','image_status'):
        if (k in source)!=(k in projected) or not same(source.get(k),projected.get(k)):
            errors.append('preserved:'+k)
    for k in ('sha256','bytes','path','kind'):
        if not same(source['receipt']['source'].get(k),projected['receipt']['source'].get(k)):
            errors.append('source:'+k)
    raw=source['receipt']['source'].get('raw_report',{})
    old=raw.get('result',{}).get('execution')
    if old:
        receipt=projected['receipt']
        current=receipt.get('execution_summary')
        if current is None:
            current=receipt['source'].get('raw_report',receipt['source'].get('report_projection',{})).get('result',{}).get('execution',{})
        for k in ('observations','releases','activations','started_ns','ended_ns','emissions','program_emissions'):
            if not same(old.get(k),current.get(k)):
                errors.append('execution:'+k)
    return errors

def memory_errors(row):
    if any(type(row.get(k)) is not int or row[k]<0 for k in ('net_bytes','peak_bytes')):
        return ['memory:type_or_negative']
    return [] if row['peak_bytes']>=row['net_bytes'] else ['memory:peak_below_net']

def audit(root, data_root, raw):
    root=Path(root); data_root=Path(data_root); errors=[]
    try:
        if raw.get('schema') != 'retained-public-projection-cost-v1':errors.append('schema')
        freeze=json.loads((root/'FREEZE.json').read_text())
        actual={p:digest((root/p).read_bytes()) for p in freeze['files']}
        if actual!=freeze['files'] or raw.get('source_hashes')!=actual:errors.append('source_hashes')
        if raw.get('freeze_sha256')!=digest((root/'FREEZE.json').read_bytes()):errors.append('freeze_sha256')
        corpus={c:json.loads((root/'inputs'/f'{c}-full.json').read_bytes()) for c in CASES}
        expected={c:json.loads((root/'inputs'/f'{c}-summary.json').read_bytes()) for c in ('entry','save')}
        outputs={}
        for case in CASES:
            for policy in POLICIES:
                key=case+'/'+policy
                record=raw['outputs'][key]
                path=data_root/record['file']; data=path.read_bytes(); value=json.loads(data)
                if record['sha256']!=digest(data) or record['bytes']!=len(data):errors.append('output_identity:'+key)
                # Exact serializer options/order of the retained candidate output.
                if data!=json.dumps(value,allow_nan=False).encode('utf-8'):errors.append('wire_serialization:'+key)
                want=expected_view(case,policy,corpus[case],expected.get(case))
                if not same(value,want):errors.append('semantic:'+key)
                errors.extend(key+':'+e for e in preserved_errors(corpus[case],value))
                outputs[key]=digest(data)
        all_orders=list(itertools.permutations(POLICIES))
        expected_schedule=[(phase,c,order_no,policy,1 if phase=='warmup' else 3) for phase in ('warmup','measured') for c in CASES for order_no,order in enumerate(all_orders) for policy in order]
        rows=raw['rows']
        found=[(r['phase'],r['case'],r['order'],r['policy'],r['count']) for r in rows]
        if found!=expected_schedule:errors.append('schedule')
        clock=raw['clock']
        if any(type(clock.get(k)) is not int or clock[k]<=0 for k in ('wall_resolution_ns','cpu_resolution_ns','empty_wall_median_low_ns','empty_cpu_median_low_ns','minimum_ns')):errors.append('clock_types')
        samples=clock['empty_brackets']
        if len(samples)!=64 or any(type(v) is not int or v<0 for s in samples for v in s):errors.append('clock_samples')
        if clock['empty_wall_median_low_ns']!=sorted(s[0] for s in samples)[31] or clock['empty_cpu_median_low_ns']!=sorted(s[1] for s in samples)[31]:errors.append('clock_median')
        required=max(1000*clock['wall_resolution_ns'],1000*clock['cpu_resolution_ns'],100*clock['empty_wall_median_low_ns'],100*clock['empty_cpu_median_low_ns'])
        if clock['minimum_ns']!=required:errors.append('clock_threshold')
        for i,row in enumerate(rows):
            key=row['case']+'/'+row['policy']
            if len(row['output_sha256s'])!=row['count'] or any(h!=outputs[key] for h in row['output_sha256s']):errors.append('repeated_output:'+str(i))
            if row['phase']=='measured':errors.extend('timing:'+str(i)+':'+e for e in timing_errors(row,clock['minimum_ns']))
        memory=raw['memory']
        if [(r['case'],r['policy']) for r in memory] != [(c,p) for c in CASES for p in POLICIES]:errors.append('memory_schedule')
        for row in memory:
            errors.extend(memory_errors(row))
            if row['output_sha256']!=outputs[row['case']+'/'+row['policy']]:errors.append('memory_output')
        if raw.get('inputs_unchanged') is not True:errors.append('input_mutation')
        hashes={c:digest(canonical(v)) for c,v in corpus.items()}
        if raw.get('input_object_before_sha256')!=hashes or raw.get('input_object_after_sha256')!=hashes:errors.append('input_object_hashes')
        if raw.get('counts')!={'warmup':54,'measured':162,'memory':9,'total':225}:errors.append('counts')
        if type(raw.get('gui_or_action_dispatches')) is not int or raw['gui_or_action_dispatches']!=0:errors.append('dispatch_count')
    except (KeyError,ValueError,TypeError,OSError,IndexError) as exc:
        errors.append('invalid_record:'+type(exc).__name__+':'+str(exc))
    return errors
