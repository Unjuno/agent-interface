"""Independent raw-output decoder and auditor; imports no study encoders."""
import argparse, copy, hashlib, json, statistics, struct, sys, zlib
from pathlib import Path
from PIL import Image

ROOT=Path(__file__).resolve().parent
APPS=['dogfood-calc-01','dogfood-inkscape-02','dogfood-xterm-03']
sha=lambda b:hashlib.sha256(b).hexdigest()

def decode(wire, previous, stream, sequence):
    magic,n=struct.unpack_from('!4sI',wire)
    if magic!=b'AIT1' or n>len(wire)-8:raise ValueError('header')
    m=json.loads(wire[8:8+n]);data=zlib.decompress(wire[8+n:])
    if (m['stream'],m['sequence'],m['base'])!=(stream,sequence,sequence-1):raise ValueError('sequence')
    w,h,mode=m['width'],m['height'],m['mode'];c={'RGB':3,'RGBA':4,'L':1}[mode]
    if m['kind']=='full':pix=data
    elif m['kind']=='unchanged':
        if data:raise ValueError('unchanged data')
        pix=previous
    elif m['kind']=='tiles':
        pix=bytearray(previous);offset=0
        for _ in range(m['count']):
            x,y,tw,th=struct.unpack_from('!IIII',data,offset);offset+=16
            if not 0<tw<=w-x or not 0<th<=h-y:raise ValueError('tile')
            for j in range(th):
                begin=((y+j)*w+x)*c;length=tw*c
                pix[begin:begin+length]=data[offset:offset+length];offset+=length
        if offset!=len(data):raise ValueError('trailing tile data')
        pix=bytes(pix)
    else:raise ValueError('kind')
    if len(pix)!=w*h*c:raise ValueError('pixels')
    return m,pix

def audit(out, rows=None):
    errors=[];checks=0
    def check(p,msg):
        nonlocal checks
        checks+=1
        if not p:errors.append(msg)
    env=json.loads((out/'environment.json').read_text());execution=json.loads((out/'execution.json').read_text())
    if rows is None:rows=[json.loads(x) for x in (out/'samples.jsonl').read_text().splitlines()]
    check(len(rows)==144 and execution['records']==144 and execution['completed'],'record count')
    manifest=json.loads((ROOT/'PROVENANCE.json').read_text())
    for r in manifest['records']:
        b=(ROOT/r['local']).read_bytes();check(hashlib.sha1(b'blob '+str(len(b)).encode()+b'\0'+b).hexdigest()==r['sha'],'source '+r['local'])
    lookup={}
    for row in rows:
        key=(row['app'],row['pass'],row['sequence'],row['arm']);check(key not in lookup,'duplicate record');lookup[key]=row
    expected_order=[];ratios=[];memory_limit=True;timing_ratios=[];details=[]
    for app in APPS:
        obs=json.loads((ROOT/'inputs'/app/'observations.json').read_text());frames=[]
        for o in obs:
            with Image.open(ROOT/'inputs'/app/Path(o['image']).name) as im:
                if env['construction']:im=im.crop((0,0,67,65))
                frames.append((im.width,im.height,im.mode,im.tobytes()))
        prior={'canonical':None,'streaming':None};first={}
        for idx,(o,(w,h,mode,pixels)) in enumerate(zip(obs,frames))):
            seq=idx+1
            for arm in ['canonical','streaming']:
                wire=(out/'wire'/f'{app}-{seq:03}-{arm}.ait').read_bytes();m,reconstructed=decode(wire,prior[arm],'dogfood',seq);prior[arm]=reconstructed;first[(seq,arm)]=(sha(wire),len(wire),m)
                check(reconstructed==pixels,'decoded pixels')
                check(m==dict(stream='dogfood',sequence=seq,base=seq-1,width=w,height=h,mode=mode,action_id=o['action_id'],observed_ns=o['capture_ns'],context=o['context'],kind=m['kind'],**({'count':m['count']} if m['kind']=='tiles' else {})),'metadata')
            check(first[(seq,'canonical')][:2]==first[(seq,'streaming')][:2],'paired exact wire')
        for rep in range(4):
            for idx,(o,(w,h,mode,pixels)) in enumerate(zip(obs,frames))):
                seq=idx+1;order=['canonical','streaming'] if (rep+idx)%2==0 else ['streaming','canonical'];pair={}
                for pos,arm in enumerate(order):
                    key=(app,rep,seq,arm);expected_order.append(key)
                    if key not in lookup:check(False,'missing record');continue
                    r=lookup[key];pair[arm]=r;digest,length,meta=first[(seq,arm)]
                    check((r['wire_sha256'],r['wire_bytes'])==(digest,length),'wire identity')
                    check(r['first_pass_hash_matches'] is True,'pass hash flag')
                    check(r['state_sequence']==seq and r['state_pixels_sha256']==sha(pixels),'state')
                    check(r['input_pixels_sha256']==sha(pixels),'input digest')
                    check(r['input']==str(Path('inputs')/app/Path(o['image']).name),'input route')
                    check((r['width'],r['height'],r['mode'])==(w,h,mode),'geometry')
                    check(r['order']==pos and r['kind']==meta['kind'],'order/kind')
                    check(type(r['changed_tiles']) is int and r['changed_tiles']>=0,'dirty count')
                    check(type(r['wall_ns']) is int and r['wall_ns']>0 and type(r['cpu_ns']) is int and r['cpu_ns']>0,'timing')
                    if rep<3:check(r['tracemalloc_peak'] is None and r['tracemalloc_current'] is None,'instrumentation separation')
                    else:check(type(r['tracemalloc_peak']) is int and r['tracemalloc_peak']>=r['tracemalloc_current']>=0,'allocation data')
                if len(pair)<2:continue
                a,b=pair['canonical'],pair['streaming'];check(a['changed_tiles']==b['changed_tiles'],'dirty parity')
                if rep==3:
                    ratio=b['tracemalloc_peak']/max(a['tracemalloc_peak'],1)
                    if seq>1 and frames[idx][3]!=frames[idx-1][3]:ratios.append(ratio)
                    within=b['tracemalloc_peak']<=1.20*a['tracemalloc_peak']+32768;memory_limit &= within
                    details.append({'app':app,'sequence':seq,'kind':a['kind'],'changed_tiles':a['changed_tiles'],'baseline_peak':a['tracemalloc_peak'],'candidate_peak':b['tracemalloc_peak'],'ratio':ratio,'within_envelope':within})
                else:timing_ratios.append(b['wall_ns']/a['wall_ns'])
    check([(r['app'],r['pass'],r['sequence'],r['arm']) for r in rows]==expected_order,'record order')
    parity=not errors
    return {'decision':'PASS_RETAINED_CAPTURE_WIRE_PARITY' if parity else 'FAIL_AUDIT','allocation_decision':'PASS_RETAINED_CAPTURE_ALLOCATION_BENEFIT' if parity and ratios and statistics.median(ratios)<=.75 and memory_limit else 'HOLD_ALLOCATION_BENEFIT','checks':checks,'errors':errors,'changed_transition_count':len(ratios),'changed_median_peak_ratio':statistics.median(ratios) if ratios else None,'all_peak_envelopes':memory_limit,'timing_paired_median_wall_ratio':statistics.median(timing_ratios) if timing_ratios else None,'memory_details':details}

def main():
    ap=argparse.ArgumentParser();ap.add_argument('out');args=ap.parse_args();out=ROOT/args.out
    result=audit(out);print(json.dumps(result,indent=2));sys.exit(bool(result['errors']))

if __name__=='__main__':main()
