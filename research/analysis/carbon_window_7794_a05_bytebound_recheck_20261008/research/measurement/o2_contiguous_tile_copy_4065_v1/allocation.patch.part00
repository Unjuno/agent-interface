@@ -0,0 +1,68 @@
+"""Research-only O2 encoder: vectorized exact dirty-mask, unchanged AIT1 wire.
+
+Trusted immutable uint8 frames only. This is not a transport or input authority.
+"""
+from pathlib import Path
+import sys
+from time import perf_counter_ns
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / 'upstream/research/observation_tiles'))
+import tile_transport as reference
+
+Frame = reference.Frame
+packet = reference.packet
+TILE = reference.TILE
+
+
+def dirty_coordinates(a: np.ndarray, b: np.ndarray, size: int) -> list[tuple[int, int]]:
+    """Return row-major (x,y) origins with any unequal channel in that tile.
+
+    The last reduceat interval ends at the array boundary; no padded pixels are
+    created, and partial right/bottom tiles retain their exact extent.
+    """
+    height, width, channels = b.shape
+    different = np.not_equal(a, b).reshape(height, width * channels)
+    horizontal = np.logical_or.reduceat(different, np.arange(0, width * channels, size * channels), axis=1)
+    mask = np.logical_or.reduceat(horizontal, np.arange(0, height, size), axis=0)
+    rows, cols = np.nonzero(mask)
+    return [(int(x) * size, int(y) * size) for y, x in zip(rows, cols)]
+
+
+class ContiguousEncoder(reference.Encoder):
+    def encode(self, frame, *, action_id, observed_ns, context=()):
+        start = perf_counter_ns()
+        seq = self.sequence + 1
+        meta = dict(stream=self.stream, sequence=seq, base=self.sequence,
+                    width=frame.width, height=frame.height, mode=frame.mode,
+                    action_id=action_id, observed_ns=observed_ns, context=context)
+        old = self.previous
+        compatible = old is not None and (old.width, old.height, old.mode) == (
+            frame.width, frame.height, frame.mode)
+        changed = 0
+        if compatible and old.pixels == frame.pixels:
+            meta['kind'] = 'unchanged'
+            wire = packet(meta, b'')
+        else:
+            meta['kind'] = 'full'
+            wire = packet(meta, frame.pixels)
+            if compatible and self.strategy == 'O2':
+                channels = {'RGB': 3, 'RGBA': 4, 'L': 1}[frame.mode]
+                shape = (frame.height, frame.width, channels)
+                a = np.frombuffer(old.pixels, np.uint8).reshape(shape)
+                b = np.frombuffer(frame.pixels, np.uint8).reshape(shape)
+                pieces = []
+                size = self.tile_size
+                for x, y in dirty_coordinates(a, b, size):
+                    tile = b[y:y+size, x:x+size]
+                    h, w = tile.shape[:2]
+                    pieces.extend((TILE.pack(x, y, w, h), np.ascontiguousarray(tile).tobytes()))
+                    changed += 1
+                tile_meta = dict(meta, kind='tiles', count=changed)
+                candidate = packet(tile_meta, b''.join(pieces))
+                if len(candidate) < len(wire):
+                    wire, meta = candidate, tile_meta
+        self.previous, self.sequence = frame, seq
+        self.last = dict(kind=meta['kind'], wire_bytes=len(wire),
+                         changed_tiles=changed, encode_ns=perf_counter_ns()-start)
+        return wire
diff --git a/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/execute.py b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/execute.py
new file mode 100644
index 0000000..36a277e
--- /dev/null
+++ b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/execute.py
@@ -0,0 +1,26 @@
+"""Synchronous supervisor. A consumed batch can never be rerun in place."""
+from pathlib import Path
+import argparse,hashlib,json,subprocess,sys,time,os
+HERE=Path(__file__).resolve().parent
+sha=lambda b:hashlib.sha256(b).hexdigest()
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--batch',type=int,choices=range(3),required=True);a=ap.parse_args()
+    freeze=json.loads((HERE/'FREEZE.json').read_text())
+    for n,h in freeze['files'].items():
+        if sha((HERE/n).read_bytes())!=h:raise ValueError('freeze changed: '+n)
+    if a.batch:
+        prev=HERE/'formal'/('batch-%d'%(a.batch-1));receipt=json.loads((prev/'EXECUTION.json').read_text())
+        assert receipt['returncode']==0 and receipt['end_sha256']==sha((prev/'END.json').read_bytes())
+    out=HERE/'formal'/('batch-%d'%a.batch);out.mkdir(parents=True,exist_ok=False)
+    cmd=[sys.executable,'-B',str(HERE/'run_batch.py'),'--batch',str(a.batch),'--out',str(out)]
+    (out/'COMMAND.json').write_text(json.dumps(cmd)+'\n')
+    env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',PYTHONDONTWRITEBYTECODE='1')
+    start=time.perf_counter_ns(); rc=None; timedout=False
+    with (out/'stdout.txt').open('wb') as stdout,(out/'stderr.txt').open('wb') as stderr:
+        try:rc=subprocess.run(cmd,stdout=stdout,stderr=stderr,env=env,timeout=30,check=False).returncode
+        except subprocess.TimeoutExpired:timedout=True
+    end=time.perf_counter_ns()
+    r={'batch':a.batch,'returncode':rc,'timed_out':timedout,'start_ns':start,'end_ns':end,'freeze_sha256':sha((HERE/'FREEZE.json').read_bytes()),'end_sha256':sha((out/'END.json').read_bytes()) if (out/'END.json').exists() else None,'stdout_sha256':sha((out/'stdout.txt').read_bytes()),'stderr_sha256':sha((out/'stderr.txt').read_bytes())}
+    (out/'EXECUTION.json').write_text(json.dumps(r,indent=2)+'\n'); print(json.dumps(r))
+    return 0 if rc==0 and r['end_sha256'] else 2
+if __name__=='__main__':raise SystemExit(main())
diff --git a/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/formal/batch-0/00-640x480-unchanged.json b/research/measurement/o2_encoding_phase_attribution_v1/contiguous_tile_copy_v1/formal/batch-0/00-640x480-unchanged.json
