@@ -0,0 +1,1062 @@
+{
+  "case": "00-640x480-unchanged",
+  "index": 0,
+  "samples": [
+    {
+      "arms": {
+        "contiguous": {
+          "changed_tiles": 0,
+          "cpu_ns": 45157,
+          "end_ns": 673283193461,
+          "initial_sha256": "bca6ff9649a7b81257e5d82721c7aeea6f8245382476d434baa4f66f76d9ab7d",
+          "kind": "unchanged",
+          "start_ns": 673283149685,
+          "wall_ns": 43776,
+          "wire_bytes": 212,
+          "wire_sha256": "9340db7d49e0efa710d7a245de10fd1b9e07e2ee9fb8b7a0eebbcf09a12ec290"
+        },
+        "legacy": {
+          "changed_tiles": 0,
+          "cpu_ns": 78417,
+          "end_ns": 673279366606,
+          "initial_sha256": "bca6ff9649a7b81257e5d82721c7aeea6f8245382476d434baa4f66f76d9ab7d",
+          "kind": "unchanged",
+          "start_ns": 673279290000,
