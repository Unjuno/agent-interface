{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "target", "container", "state", "reason"],
  "properties": {
    "decision": {"enum": ["TARGET", "STATE", "NO_ACTION", "YIELD"]},
    "target": {"type": ["string", "null"]},
    "container": {"type": ["string", "null"]},
    "state": {"type": ["string", "null"], "enum": ["ENABLED", "DISABLED", "STATUS_SAVED", "STATUS_PAUSED", null]},
    "reason": {"type": ["string", "null"], "enum": ["TARGET_ABSENT", "AMBIGUOUS", "UNSUPPORTED", "INSUFFICIENT_EVIDENCE", null]}
  }
}
