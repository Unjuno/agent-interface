"""Read-only retained engineering artifact check. No extraction or GUI replay."""
import ast,hashlib,json,re,tarfile
from pathlib import Path,PurePosixPath
ROOT=Path(__file__).resolve().parent

def need(ok,message):
    if not ok:raise ValueError(message)
def sha(data):return hashlib.sha256(data).hexdigest()
manifest=json.loads((ROOT/'manifest.json').read_text())
need(sha((ROOT/'raw.tar.gz').read_bytes())==manifest['archive_sha256'],'archive digest')
files={}
with tarfile.open(ROOT/'raw.tar.gz','r:gz') as archive:
    for member in archive.getmembers():
        path=PurePosixPath(member.name)
        need(member.isfile() and not path.is_absolute() and '..' not in path.parts,'unsafe member')
        need(member.name not in files,'duplicate member')
        files[member.name]=archive.extractfile(member).read()
need(set(files)==set(manifest['files']),'member closure')
for name,data in files.items():
    entry=manifest['files'][name]
    need(len(data)==entry['bytes'] and sha(data)==entry['sha256'],'member bytes '+name)env=json.loads(files['environment.json'])
need(env['candidate_commit']=='75b9dee93523dfb08c60980e259eb25650a8b95d','candidate pin')
need(env['baseline_commit']=='59ffec5d551b0adcf11057eee6da814237a748c8','baseline pin')
old=files['source/baseline/mcp_server.py']
need(hashlib.sha1(b'blob '+str(len(old)).encode()+b'\0'+old).hexdigest()=='7227f105aa4481a6110cd384a038bc72aa0aabda','baseline Git blob')
for name in ['mcp_server.py','test_mcp_server.py']:ast.parse(files['source/candidate/'+name].decode())
for stem in ['red-02','callback-red']:
    need(int(files[stem+'.exit.txt'].decode().strip())==1,'red exit')
    need(b'FAILED (failures=1)' in files[stem+'.stderr.txt'] and b'AssertionError' in files[stem+'.stderr.txt'],'red assertion')
for stem,count in [('ownership-green',66),('cli',240)]:
    need(int(files[stem+'.exit.txt'].decode().strip())==0,'green exit')
    need(re.search(rb'Ran '+str(count).encode()+rb' tests.*\n\s*\nOK',files[stem+'.stderr.txt']) is not None,'suite count')
need(int(files['native.exit.txt'].decode().strip())==0,'native outer exit')
result=json.loads(files['native-check/result.json']);need(result['status']=='PASS','native status')
need(len(result['suites'])==2 and all(s['returncode']==0 for s in result['suites']),'native suites')
for suite,count in [('protocol',324),('harness',135)]:
    log=files['native-check/'+suite+'.stderr.log']
    need(re.search(rb'Ran '+str(count).encode()+rb' tests.*\n\s*\nOK',log) is not None,'native count')
print(json.dumps({'status':'PASS_RETAINED_ENGINEERING_TEST_ACCOUNTING','files':len(files),'cli_tests':240,'protocol_tests':324,'harness_tests':135,'scope':'Exact archived source/log accounting only. Does not substitute for executing tests or establish live/native effects/performance.'},indent=2))
