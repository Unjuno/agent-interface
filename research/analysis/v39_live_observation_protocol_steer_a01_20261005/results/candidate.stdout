        "x-codex-turn-metadata": "{\"installation_id\":\"8db50a81-534e-44d3-b1fa-69c644fed767\",\"session_id\":\"01a10a69-8a13-7a22-afa5-53df975d26a3\",\"thread_id\":\"01a10a69-8a13-7a22-afa5-53df975d26a3\",\"turn_id\":\"01a10a69-8a96-7041-a94c-aeefcf8677ef\",\"window_id\":\"01a10a69-8a13-7a22-afa5-53df975d26a3:0\",\"request_kind\":\"turn\",\"sandbox\":\"seatbelt\",\"code_mode_tool_names\":{\"apply_patch\":{\"name\":\"apply_patch\",\"namespace\":null},\"create_goal\":{\"name\":\"create_goal\",\"namespace\":null},\"exec_command\":{\"name\":\"exec_command\",\"namespace\":null},\"get_goal\":{\"name\":\"get_goal\",\"namespace\":null},\"multi_agent_v1__close_agent\":{\"name\":\"close_agent\",\"namespace\":\"multi_agent_v1\"},\"multi_agent_v1__resume_agent\":{\"name\":\"resume_agent\",\"namespace\":\"multi_agent_v1\"},\"multi_agent_v1__send_input\":{\"name\":\"send_input\",\"namespace\":\"multi_agent_v1\"},\"multi_agent_v1__spawn_agent\":{\"name\":\"spawn_agent\",\"namespace\":\"multi_agent_v1\"},\"multi_agent_v1__wait_agent\":{\"name\":\"wait_agent\",\"namespace\":\"multi_agent_v1\"},\"update_goal\":{\"name\":\"update_goal\",\"namespace\":null},\"update_plan\":{\"name\":\"update_plan\",\"namespace\":null},\"view_image\":{\"name\":\"view_image\",\"namespace\":null},\"write_stdin\":{\"name\":\"write_stdin\",\"namespace\":null}},\"turn_started_at_unix_ms\":1791176051370}",
