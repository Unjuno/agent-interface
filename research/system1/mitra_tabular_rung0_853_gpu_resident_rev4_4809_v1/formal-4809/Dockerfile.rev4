FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime@sha256:831247999fbf7e08f61b3e39f6d77ee434f38f6f07f769d00db451e853878067
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1
COPY wheelhouse /wheelhouse
COPY formal-4809/src/requirements.lock /tmp/requirements.base.lock
COPY formal-4809/requirements.successor.rev4.lock /tmp/requirements.successor.rev4.lock
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheelhouse --require-hashes -r /tmp/requirements.base.lock \
 && python -m pip install --no-cache-dir --no-index --find-links=/wheelhouse --require-hashes -r /tmp/requirements.successor.rev4.lock \
 && python -c 'import omegaconf, antlr4, loguru, einops, einx; from autogluon.tabular.models.mitra.sklearn_interface import MitraClassifier; print("DIRECT_IMPORT_OK", MitraClassifier.__name__)'
WORKDIR /src
ENTRYPOINT ["python", "/src/runner.py"]
